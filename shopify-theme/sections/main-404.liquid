<section class="max-w-[820px] mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 text-center">
  <div class="inline-flex items-center gap-2 bg-cream border border-black/5 rounded-full px-3 py-1.5 text-xs font-bold"><i class="ri-error-warning-line"></i> 404 — Page not found</div>
  <h1 class="display text-[40px] sm:text-[56px] leading-none mt-4">Lost?<br><span class="serif2 italic font-normal">We’ll get you back.</span></h1>
  <p class="text-sm sm:text-[15px] text-muted leading-relaxed max-w-[520px] mx-auto mt-4">The page you’re looking for doesn’t exist or was moved. Try searching or browse our bestselling ebooks.</p>
  <form action="{{ routes.search_url }}" method="get" class="flex gap-2 max-w-[520px] mx-auto mt-8">
    <input type="search" name="q" placeholder="Search ebooks..." class="flex-1 bg-white border border-black/10 rounded-full px-5 py-3.5 text-sm outline-none focus:border-ink">
    <button class="bg-ink text-white px-6 py-3.5 rounded-full font-bold text-sm shrink-0">Search</button>
  </form>
  <div class="flex flex-wrap justify-center gap-3 mt-6">
    <a href="{{ routes.root_url }}" class="bg-ink text-white px-6 py-3 rounded-full font-bold text-sm">Back to Home</a>
    <a href="{{ routes.collections_url }}/all" class="bg-white border border-black/10 px-6 py-3 rounded-full font-bold text-sm">View All Ebooks</a>
  </div>
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-12 text-left">
    {% for collection in collections limit:3 %}
      <a href="{{ collection.url }}" class="bg-white border border-black/5 rounded-2xl p-4 card-hover">
        <div class="w-10 h-10 rounded-xl bg-cream grid place-items-center"><i class="ri-stack-line"></i></div>
        <div class="font-bold text-sm mt-3">{{ collection.title }}</div><div class="text-xs text-muted">{{ collection.products_count }} ebooks</div>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}{"name":"Main 404","settings":[]}{% endschema %}
