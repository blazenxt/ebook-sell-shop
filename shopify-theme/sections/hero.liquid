<section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-10">
  <div class="grid lg:grid-cols-12 gap-6 items-stretch min-w-0">
    <div class="relative overflow-hidden rounded-[28px] bg-ink text-white p-5 sm:p-10 lg:p-12 flex flex-col justify-between min-h-[460px] sm:min-h-[520px] lg:col-span-7">
      <div class="absolute inset-0 opacity-[0.07]" style="background-image:radial-gradient(circle at 1px 1px, white 1px, transparent 0);background-size:22px 22px"></div>
      <div class="hidden sm:block absolute -right-20 -bottom-20 w-[380px] h-[380px] bg-gold/20 blur-[80px] rounded-full"></div>
      <div class="relative">
        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur border border-white/10 rounded-full px-3 py-1.5 text-[11px] sm:text-xs font-semibold tracking-wide max-w-full flex-wrap">
          <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span> 12,847+ readers downloaded today
        </div>
        <h1 class="display text-[34px] xs:text-[38px] sm:text-[54px] lg:text-[62px] leading-[0.92] tracking-tight mt-6 break-words max-w-full">
          {{ section.settings.heading | default: 'Knowledge,' }}<br>
          <span class="serif2 italic font-normal text-gold">{{ section.settings.subheading | default: 'instantly yours.' }}</span>
        </h1>
        <p class="text-white/70 text-[15px] sm:text-[16px] leading-relaxed max-w-[520px] mt-4">
          {{ section.settings.description | default: 'Curated ebooks — Business, Self-Help, Fiction, UPSC. Pay via UPI / Razorpay & download in 10 seconds. No waiting, no shipping.' }}
        </p>
        <div class="flex flex-wrap gap-3 mt-8 w-full">
          <a href="{{ routes.collections_url }}" class="inline-flex items-center gap-2 bg-gold text-ink px-7 py-3.5 rounded-full font-bold text-sm hover:bg-white transition">Explore Ebooks <i class="ri-arrow-right-line"></i></a>
          <a href="#howItWorks" class="inline-flex items-center gap-2 bg-white/10 backdrop-blur border border-white/20 text-white px-7 py-3.5 rounded-full font-bold text-sm hover:bg-white hover:text-ink transition"><i class="ri-play-circle-line"></i> How does it work?</a>
        </div>
        <div class="flex flex-wrap items-center gap-4 sm:gap-6 mt-8 sm:mt-10">
          <div class="flex -space-x-2">
            <img src="https://i.pravatar.cc/100?img=32" class="w-9 h-9 rounded-full border-2 border-ink">
            <img src="https://i.pravatar.cc/100?img=14" class="w-9 h-9 rounded-full border-2 border-ink">
            <img src="https://i.pravatar.cc/100?img=28" class="w-9 h-9 rounded-full border-2 border-ink">
            <span class="w-9 h-9 rounded-full bg-gold text-ink grid place-items-center text-xs font-bold border-2 border-ink">+12k</span>
          </div>
          <div class="text-sm leading-tight">
            <div class="flex items-center gap-1 text-gold text-[14px]"><span class="flex gap-0.5"><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i></span> <span class="text-white/80 ml-2 font-bold">4.9/5</span></div>
            <div class="text-white/60 text-xs">2,400+ verified reviews</div>
          </div>
        </div>
      </div>
    </div>

    <div class="grid lg:col-span-5 gap-6 auto-rows-auto lg:grid-rows-[1.6fr_0.9fr]">
      {% assign featured_product = section.settings.featured_product %}
      {% if featured_product != blank %}
        {% assign p = all_products[featured_product] %}
      {% else %}
        {% assign p = collections.all.products.first %}
      {% endif %}

      {% if p %}
      <div class="relative overflow-hidden rounded-[28px] bg-white border border-black/5 p-5 sm:p-7 flex flex-col sm:flex-row gap-5 sm:gap-6 items-center sm:items-start">
        <div class="absolute top-0 right-0 bg-gold text-ink text-[11px] font-extrabold tracking-widest px-4 py-1.5 rounded-bl-2xl">EDITORS' CHOICE</div>
        <div class="shrink-0 mx-auto sm:mx-0">
          <div class="w-[150px] xs:w-[160px] sm:w-[185px] h-[215px] xs:h-[232px] sm:h-[268px] rounded-2xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.22)] sm:rotate-[-2deg] relative bg-gradient-to-br from-[#1A2332] to-[#0F172A] p-3 flex flex-col max-w-full">
            {% if p.featured_image %}
              <img src="{{ p.featured_image | image_url: width: 400 }}" alt="{{ p.title }}" class="absolute inset-0 w-full h-full object-cover opacity-60">
              <div class="absolute inset-0 bg-gradient-to-br from-[#1A2332]/80 to-[#0F172A]/80"></div>
            {% endif %}
            <div class="relative text-[9px] tracking-[0.2em] text-white/60 font-bold">MAVIZIO ORIGINALS</div>
            <div class="relative mt-3 text-white leading-tight">
              <div class="text-[18px] font-bold leading-none display">{{ p.title | truncate: 24 }}</div>
              <div class="text-[11px] text-white/70 mt-2">{{ p.type | default: 'English • Free audio summary' }}</div>
            </div>
            <div class="relative mt-auto flex items-center gap-2">
              <span class="text-[11px] text-white font-semibold">{{ p.vendor | default: 'Mavizio' }}</span>
            </div>
          </div>
        </div>
        <div class="flex-1 min-w-0 w-full sm:w-auto text-center sm:text-left">
          <div class="flex items-center justify-center sm:justify-start gap-2 text-xs font-bold flex-wrap">
            <span class="bg-green-50 text-green-700 border border-green-200 px-2.5 py-1 rounded-full flex items-center gap-1"><i class="ri-flashlight-fill text-green-600"></i> Instant Download</span>
            <span class="hidden sm:inline text-muted font-medium">PDF + EPUB + MOBI</span>
          </div>
          <h3 class="display text-[22px] leading-tight mt-3"><a href="{{ p.url }}">{{ p.title }}</a></h3>
          <p class="text-sm text-muted leading-relaxed mt-1.5 line-clamp-2">{{ p.description | strip_html | truncate: 90 }}</p>
          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-1.5 mt-3 text-gold text-sm"><span class="flex gap-0.5"><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i></span> <span class="text-ink font-bold text-sm">4.9</span> <span class="text-muted font-medium text-xs">({{ p.metafields.custom.reviews | default: 1842 }})</span></div>
          <div class="flex items-baseline justify-center sm:justify-start gap-2 mt-4 flex-wrap">
            <span class="text-[26px] font-extrabold tracking-tight">{{ p.price | money }}</span>
            {% if p.compare_at_price > p.price %}<span class="text-sm line-through text-muted">{{ p.compare_at_price | money }}</span>{% endif %}
            <span class="text-xs font-extrabold bg-green-500 text-white px-2 py-1 rounded-full">60% OFF</span>
          </div>
          <div class="flex gap-2 mt-4">
            <a href="{{ p.url }}" class="flex-1 bg-ink text-white rounded-full py-3 font-bold text-sm hover:bg-black transition text-center">View Details</a>
            <form method="post" action="{{ routes.cart_add_url }}" class="flex-1">
              <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
              <button type="submit" class="w-full bg-gold text-ink rounded-full py-3 font-bold text-sm hover:bg-yellow-400 transition">Add to Cart</button>
            </form>
          </div>
        </div>
      </div>
      {% endif %}

      <div class="grid grid-cols-3 gap-3 sm:gap-4">
        <div class="bg-gold rounded-[22px] p-4 sm:p-5 flex flex-col justify-center">
          <div class="text-[22px] sm:text-[28px] font-extrabold leading-none">50k+</div>
          <div class="text-xs font-bold tracking-wide opacity-70 mt-1">EBOOKS SOLD</div>
          <div class="mt-3 text-xs font-medium opacity-70 hidden sm:block">Trusted by readers across India</div>
        </div>
        <div class="bg-white border border-black/5 rounded-[22px] p-4 sm:p-5 flex flex-col justify-center">
          <div class="w-8 h-8 bg-cream rounded-full grid place-items-center"><i class="ri-flashlight-line"></i></div>
          <div class="text-sm font-extrabold mt-3 leading-tight">10 Sec<br>Delivery</div>
          <div class="text-xs text-muted mt-1">Email + WhatsApp</div>
        </div>
        <div class="bg-white border border-black/5 rounded-[22px] p-4 sm:p-5 flex flex-col justify-center">
          <div class="w-8 h-8 bg-cream rounded-full grid place-items-center"><i class="ri-customer-service-2-line"></i></div>
          <div class="text-sm font-extrabold mt-3 leading-tight">Lifetime<br>Access</div>
          <div class="text-xs text-muted mt-1">Re-download anytime</div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Mavizio",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Knowledge,"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "instantly yours."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Curated ebooks — Business, Self-Help, Fiction, UPSC. Pay via UPI / Razorpay & download in 10 seconds. No waiting, no shipping."
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Featured product"
    }
  ],
  "presets": [
    {
      "name": "Hero Mavizio"
    }
  ]
}
{% endschema %}
