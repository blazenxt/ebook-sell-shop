<div class="bg-white border-b border-line">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-3">
    <nav class="flex items-center gap-1.5 text-xs text-muted">
      <a href="{{ routes.root_url }}" class="hover:text-ink">Home</a><i class="ri-arrow-right-s-line text-line"></i>
      <span class="text-ink font-medium">Wishlist</span>
      <span class="ml-auto hidden sm:inline-flex items-center gap-1.5 text-xs font-bold text-leaf bg-leafSoft border border-leaf/10 px-2.5 py-1 rounded-full"><i class="ri-heart-3-fill text-gold"></i> Saved for later</span>
    </nav>
  </div>
</div>

<section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 mt-4">
  <div class="bg-white rounded-2xl border border-line p-6 sm:p-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-2xl bg-cream border border-gold/20 grid place-items-center relative overflow-hidden">
          <i class="ri-heart-3-fill text-gold text-2xl wishlist-heart"></i>
          <span class="absolute inset-0 bg-gold/10 animate-ping rounded-2xl"></span>
        </div>
        <div>
          <h1 class="font-serif text-2xl font-bold leading-none">Your Wishlist</h1>
          <p class="text-xs text-muted mt-1">Tap the gold heart to save • <span class="text-gold font-bold">Auto-saved</span> on this device</p>
        </div>
      </div>
      <div class="flex items-center gap-2 text-xs">
        <span class="bg-paper border border-line rounded-full px-3 py-1.5 font-bold">Share: <i class="ri-share-line ml-1"></i></span>
        <span class="bg-ink text-white rounded-full px-4 py-1.5 font-bold">Move all to Cart</span>
      </div>
    </div>

    <div id="wishlist-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4 mt-6">
      <!-- Example wishlist cards with gold heart animation -->
      {% for product in collections.all.products limit: 4 %}
        <div class="group bg-white border border-line rounded-2xl p-3 relative overflow-hidden hover:border-gold/30 hover:shadow-md transition">
          <button class="absolute top-3 right-3 w-8 h-8 bg-white border border-line rounded-full grid place-items-center shadow-sm wishlist-btn group-hover:bg-cream transition" data-wish="{{ product.id }}">
            <i class="ri-heart-3-fill text-gold text-lg wishlist-heart-icon"></i>
          </button>
          <div class="aspect-[3/4] bg-paper rounded-xl border border-line p-2 flex items-center justify-center">
            {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title }}" class="max-h-full max-w-full object-contain">{% else %}<i class="ri-book-line text-2xl text-muted"></i>{% endif %}
          </div>
          <div class="mt-3">
            <div class="text-xs text-muted truncate">{{ product.vendor | default: 'Mavizio' }}</div>
            <div class="text-sm font-medium line-clamp-2 leading-tight mt-1">{{ product.title }}</div>
            <div class="flex items-baseline gap-2 mt-2">
              <span class="font-bold text-sm">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}<span class="text-xs line-through text-muted">{{ product.compare_at_price | money }}</span>{% endif %}
            </div>
            <button class="mt-3 w-full bg-ink text-white py-2 rounded-full text-xs font-bold hover:bg-black">Move to Cart</button>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="mt-6 bg-cream border border-gold/20 rounded-2xl p-4 flex flex-col sm:flex-row items-center justify-between gap-3">
      <div class="flex items-center gap-2 text-sm"><i class="ri-heart-3-fill text-gold text-lg wishlist-heart"></i><span><b>Gold hearts</b> beat when you save — try tapping! • Wishlist is saved locally</span></div>
      <a href="{{ routes.collections_url }}/all" class="bg-white border border-line px-4 py-2 rounded-full text-xs font-bold hover:bg-ink hover:text-white transition">Continue Shopping</a>
    </div>
  </div>
</section>

<style>
@keyframes heartBeat {
  0% { transform: scale(1); }
  15% { transform: scale(1.25); }
  30% { transform: scale(0.95); }
  45% { transform: scale(1.15); }
  60% { transform: scale(1); }
}
.wishlist-heart {
  animation: heartBeat 1.6s ease-in-out infinite;
  filter: drop-shadow(0 0 8px rgba(193,154,92,0.35));
}
.wishlist-heart-icon {
  animation: heartBeat 1.8s ease-in-out infinite;
}
.wishlist-btn:active .wishlist-heart-icon {
  animation: heartBeat 0.5s ease-in-out;
  transform: scale(1.3);
}
.wishlist-btn:hover {
  border-color: #C19A5C;
  background: #FFF8E6;
}
</style>

{% schema %}{"name":"Main Wishlist Gold Heart","settings":[]}{% endschema %}
