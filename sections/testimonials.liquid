<section id="testimonials" class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 mt-8">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
    <div>
      <div class="inline-flex items-center gap-2 bg-cream border border-black/5 rounded-full px-3 py-1 text-xs font-bold"><i class="ri-double-quotes-l text-gold"></i> REAL REVIEWS</div>
      <h2 class="display text-[26px] sm:text-[32px] leading-none mt-2 font-extrabold">Loved by readers <span class="text-muted font-normal">like you</span></h2>
    </div>
    <div class="hidden sm:flex items-center gap-2 text-sm"><span class="flex text-gold"><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i></span><b>4.9/5</b><span class="text-muted">• 2,400+ verified</span></div>
  </div>
  <div class="grid md:grid-cols-3 gap-4 mt-6">
    {% assign reviews = "Ankit Gautam:IIT aspirant cracked 2 ebooks in 1 week, notes are gold:5;Priya Sharma:Self-help bundle changed my morning routine — instant download!:5;Rahul Verma:UPSC PDFs are concise, audio summary is killer:5" | split: ";" %}
    {% for r in reviews %}
      {% assign parts = r | split: ":" %}
      <div class="bg-white border border-black/5 rounded-[20px] p-5">
        <div class="flex text-gold gap-0.5 text-sm">{% for i in (1..5) %}<i class="ri-star-fill"></i>{% endfor %}</div>
        <p class="text-sm leading-relaxed mt-3 font-medium">"{{ parts[1] }}"</p>
        <div class="flex items-center gap-3 mt-4">
          <img src="https://i.pravatar.cc/100?img={{ forloop.index | plus: 20 }}" class="w-9 h-9 rounded-full">
          <div><div class="text-sm font-bold">{{ parts[0] }}</div><div class="text-xs text-muted">Verified buyer • ₹499 bundle</div></div>
          <span class="ml-auto bg-green-50 text-green-700 border border-green-200 px-2 py-1 rounded-full text-[10px] font-bold flex items-center gap-1"><i class="ri-verified-badge-fill"></i> Verified</span>
        </div>
      </div>
    {% endfor %}
  </div>
</section>
{% schema %}{"name":"Testimonials","settings":[]}{% endschema %}
