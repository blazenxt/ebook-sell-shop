<div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-4">
  <nav class="flex items-center gap-2 text-xs font-semibold text-muted">
    <a href="{{ routes.root_url }}" class="hover:text-ink">Home</a> <i class="ri-arrow-right-s-line"></i> <a href="{{ routes.collections_url }}" class="hover:text-ink">Shop</a> <i class="ri-arrow-right-s-line"></i> <span class="text-ink truncate">{{ product.title }}</span>
  </nav>
</div>

<section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 pb-12">
  <div class="grid lg:grid-cols-12 gap-6 lg:gap-10">
    <div class="lg:col-span-5">
      <div class="bg-white border border-black/5 rounded-[24px] p-6 sm:p-8">
        <div class="aspect-[3/4] max-w-[360px] mx-auto rounded-2xl overflow-hidden bg-gradient-to-br from-[#1A2332] to-[#0F172A] p-6 flex flex-col shadow-xl relative">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" class="absolute inset-0 w-full h-full object-cover opacity-40">
            <div class="absolute inset-0 bg-gradient-to-br from-[#1A2332]/80 to-[#0F172A]/80"></div>
          {% endif %}
          <div class="relative text-[10px] tracking-[0.2em] font-bold text-white/70">MAVIZIO ORIGINALS • {{ product.type | upcase | default: 'EBOOK' }}</div>
          <div class="relative display text-[28px] sm:text-[32px] leading-none mt-6 text-white font-semibold">{{ product.title }}</div>
          <div class="relative text-sm text-white/70 mt-3">{{ product.vendor }}</div>
          <div class="relative mt-auto flex flex-wrap gap-2">
            <span class="text-xs bg-white text-ink px-3 py-1.5 rounded-full font-bold">PDF + EPUB + MOBI</span>
          </div>
        </div>
        <div class="flex gap-2 mt-6 justify-center">
          <span class="bg-ink text-white px-3 py-1.5 rounded-full text-xs font-bold">PDF</span>
          <span class="bg-paper border border-black/10 px-3 py-1.5 rounded-full text-xs font-bold">EPUB</span>
          <span class="bg-paper border border-black/10 px-3 py-1.5 rounded-full text-xs font-bold">MOBI</span>
          <span class="bg-gold text-ink px-3 py-1.5 rounded-full text-xs font-bold">Audio Summary</span>
        </div>
      </div>
    </div>

    <div class="lg:col-span-7 min-w-0">
      <div class="flex flex-wrap items-center gap-2 text-xs font-bold">
        <span class="bg-green-50 text-green-700 border border-green-200 px-3 py-1.5 rounded-full flex items-center gap-1"><i class="ri-flashlight-fill"></i> Instant Download</span>
        <span class="bg-white border border-black/10 px-3 py-1.5 rounded-full text-muted">30-day refund</span>
        {% if product.tags.first %}<span class="bg-gold text-ink px-3 py-1.5 rounded-full">{{ product.tags.first }}</span>{% endif %}
      </div>
      <h1 class="display text-[28px] sm:text-[36px] leading-tight mt-4 break-words">{{ product.title }}</h1>
      <div class="text-sm text-muted mt-2">by <b class="text-ink">{{ product.vendor }}</b> • {{ product.type | default: 'English' }} • Digital</div>
      <div class="flex flex-wrap items-center gap-3 mt-4">
        <span class="flex text-gold gap-0.5"><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i></span>
        <b class="text-sm">4.9</b><span class="text-sm text-muted">({{ product.metafields.custom.reviews | default: 1200 }} reviews)</span>
      </div>
      <div class="text-[15px] leading-relaxed text-ink/80 mt-5">{{ product.description }}</div>

      <div class="flex flex-wrap items-baseline gap-3 mt-6">
        <span class="text-[34px] font-extrabold">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}<span class="text-sm line-through text-muted">{{ product.compare_at_price | money }}</span><span class="bg-green-500 text-white text-xs font-extrabold px-2.5 py-1 rounded-full">{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}% OFF</span>{% endif %}
      </div>

      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <div class="flex gap-3 mt-6">
          <div class="flex items-center gap-2 bg-white border border-black/10 rounded-full p-1">
            <button type="button" onclick="this.nextElementSibling.stepDown()" class="w-9 h-9 rounded-full bg-paper grid place-items-center">−</button>
            <input type="number" name="quantity" value="1" min="1" class="w-10 text-center font-bold bg-transparent outline-none">
            <button type="button" onclick="this.previousElementSibling.stepUp()" class="w-9 h-9 rounded-full bg-ink text-white grid place-items-center">+</button>
          </div>
          <button type="submit" name="add" class="flex-1 bg-white border border-black/10 rounded-full py-3.5 font-bold hover:bg-paper transition">Add to Cart</button>
          <button type="submit" name="add" class="flex-1 bg-gold text-ink rounded-full py-3.5 font-extrabold hover:bg-yellow-400 transition">{{ 'products.product.buy_now' | t | default: 'Buy Now' }}</button>
        </div>
      {% endform %}

      <div class="flex flex-wrap items-center justify-center gap-4 mt-4 text-xs font-semibold text-muted">
        <span class="flex items-center gap-1"><i class="ri-shield-check-line"></i> Razorpay Secure</span><span>•</span><span class="flex items-center gap-1"><i class="ri-refund-2-line"></i> 30-day refund</span>
      </div>

      <div class="mt-8 border-t border-black/5 pt-6">
        <div class="bg-cream border border-dashed border-black/10 rounded-2xl p-5">
          <div class="text-xs font-bold tracking-wide">WHAT YOU'LL GET</div>
          <div class="grid grid-cols-2 gap-3 mt-3 text-sm">
            <span class="flex gap-2 items-center"><i class="ri-checkbox-circle-fill text-green-500"></i> PDF + EPUB + MOBI</span>
            <span class="flex gap-2 items-center"><i class="ri-checkbox-circle-fill text-green-500"></i> Audio summary</span>
            <span class="flex gap-2 items-center"><i class="ri-checkbox-circle-fill text-green-500"></i> Worksheets</span>
            <span class="flex gap-2 items-center"><i class="ri-checkbox-circle-fill text-green-500"></i> Lifetime updates</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}
