<div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-4 border-b border-white/10">
  <nav class="flex items-center gap-2 text-xs text-white/50">
    <a href="{{ routes.root_url }}" class="hover:text-white">Home</a><i class="ri-arrow-right-s-line"></i>
    <a href="{{ routes.collections_url }}/all" class="hover:text-white">Shop</a><i class="ri-arrow-right-s-line"></i>
    <span class="text-white truncate">{{ product.title }}</span>
  </nav>
</div>
<section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="grid lg:grid-cols-2 gap-8 lg:gap-12">
    <div class="bg-[#141414] border border-white/10 rounded-[12px] overflow-hidden">
      {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" class="w-full h-auto">{% else %}<div class="aspect-[3/4] grid place-items-center bg-[#1A1A1A] text-white/50"><i class="ri-image-line text-3xl"></i></div>{% endif %}
    </div>
    <div>
      <div class="text-[11px] tracking-[0.2em] text-white/50">{{ product.type | default: 'Ebook' | upcase }} • {{ product.vendor | default: 'Elias Thorne' | upcase }}</div>
      <h1 class="display text-[32px] sm:text-[40px] leading-none mt-2 text-white">{{ product.title }}</h1>
      {% if product.description != blank %}<div class="prose prose-invert prose-sm mt-4 text-white/70 leading-relaxed">{{ product.description }}</div>{% endif %}
      <div class="flex items-baseline gap-3 mt-6">
        <span class="text-2xl font-bold text-[#FFB800]">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}<span class="text-sm line-through text-white/40">{{ product.compare_at_price | money }}</span>{% endif %}
      </div>
      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <div class="flex gap-3 mt-6">
          <input type="number" name="quantity" value="1" min="1" class="w-16 bg-[#141414] border border-white/10 rounded-md px-3 py-3 text-center text-white">
          <button type="submit" class="flex-1 bg-[#FFB800] text-black rounded-md py-3 font-bold hover:bg-white transition">Add to Cart — {{ product.price | money }}</button>
        </div>
      {% endform %}
      <div class="text-xs text-white/40 mt-3">Secure • Instant download • Lifetime</div>
    </div>
  </div>
</section>
{% schema %}{"name":"Main Product Luxury","settings":[]}{% endschema %}
