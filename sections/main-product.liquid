<div class="bg-white border-b border-line">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-2.5">
    <nav class="flex items-center gap-1.5 text-xs text-muted">
      <a href="{{ routes.root_url }}" class="hover:text-ink">Home</a>
      <span class="text-ink truncate font-medium">{{ product.title }}</span>
    </nav>
  </div>
</div>
<section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 mt-4">
  <div class="grid lg:grid-cols-12 gap-4">
    <div class="lg:col-span-5 bg-white rounded-2xl border border-line p-4">
      <div class="rounded-xl border border-line bg-paper p-4">
        {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 640 }}" alt="{{ product.title | escape }}" class="w-full h-auto object-contain">{% else %}<div class="aspect-[3/4] bg-paper grid place-items-center"><i class="ri-image-line"></i></div>{% endif %}
      </div>
      <div class="mt-4 p-3 bg-leafSoft rounded-xl text-center text-sm">TEST NO FORM — if this renders, form tags were breaking</div>
    </div>
    <div class="lg:col-span-7 bg-white rounded-2xl border border-line p-6">
      <span class="bg-ink text-white px-2.5 py-1 rounded-full text-xs">Bestseller</span>
      <h1 class="font-serif text-2xl mt-3">{{ product.title }}</h1>
      <div class="text-2xl font-bold mt-4">{{ product.price | money }}</div>
      {% if product.description != blank %}<div class="mt-4 prose">{{ product.description }}</div>{% endif %}
      <div class="mt-4">Available offers • Bank Offer • Special Price</div>
    </div>
  </div>
</section>
{% schema %}{"name":"Main Product Refined No Form","settings":[]}{% endschema %}
