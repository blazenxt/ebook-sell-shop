<div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-6 border-b border-stone/50">
  <nav class="flex items-center gap-2 text-xs text-muted">
    <a href="{{ routes.root_url }}" class="hover:text-ink">Home</a><i class="ri-arrow-right-s-line"></i>
    <a href="{{ routes.collections_url }}/all" class="hover:text-ink">Shop</a><i class="ri-arrow-right-s-line"></i>
    <span class="text-ink truncate">{{ product.title }}</span>
  </nav>
</div>

<section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
  <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-start">
    <div class="lg:col-span-6">
      <div class="bg-white border border-stone rounded-[24px] overflow-hidden">
        {% if product.featured_image %}
          <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title | escape }}" class="w-full h-auto">
        {% else %}
          <div class="aspect-[3/4] grid place-items-center bg-sand text-muted"><i class="ri-image-line text-3xl"></i></div>
        {% endif %}
      </div>
      {% if product.images.size > 1 %}
      <div class="grid grid-cols-4 gap-3 mt-4">
        {% for img in product.images limit: 4 %}
          <img src="{{ img | image_url: width: 300 }}" alt="{{ product.title }}" class="w-full aspect-square object-cover rounded-xl border border-stone">
        {% endfor %}
      </div>
      {% endif %}
    </div>

    <div class="lg:col-span-6 min-w-0">
      <div class="text-[11px] tracking-[0.18em] text-muted">{{ product.type | default: product.product_type | default: 'Ebook' | upcase }}{% if product.vendor != blank %} • {{ product.vendor | upcase }}{% endif %}</div>
      <h1 class="display text-[30px] sm:text-[40px] leading-[0.95] mt-2">{{ product.title }}</h1>
      {% if product.description != blank %}
        <div class="prose prose-sm max-w-none mt-4 text-muted leading-relaxed">{{ product.description }}</div>
      {% endif %}

      <div class="flex items-baseline gap-3 mt-6">
        <span class="text-[28px] font-semibold">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}<span class="text-sm text-muted line-through">{{ product.compare_at_price | money }}</span>{% endif %}
      </div>
      {% if product.available == false %}<div class="text-sm text-red mt-2">Sold out</div>{% endif %}

      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <div class="flex gap-3 mt-6">
          <div class="flex items-center gap-2 border border-stone rounded-full p-1 bg-white">
            <button type="button" onclick="this.nextElementSibling.stepDown()" class="w-9 h-9 rounded-full hover:bg-paper grid place-items-center">−</button>
            <input type="number" name="quantity" value="1" min="1" class="w-12 text-center bg-transparent outline-none font-medium">
            <button type="button" onclick="this.previousElementSibling.stepUp()" class="w-9 h-9 rounded-full bg-ink text-paper grid place-items-center">+</button>
          </div>
          <button type="submit" name="add" {% unless product.available %}disabled{% endunless %} class="flex-1 bg-ink text-paper rounded-full py-3.5 text-sm font-medium hover:bg-black disabled:opacity-40 transition">Add to cart</button>
        </div>
        {% if product.available %}<div class="text-xs text-muted mt-3">Secure checkout • Instant download after payment</div>{% endif %}
      {% endform %}

      {% if product.tags.size > 0 %}
      <div class="flex flex-wrap gap-2 mt-6">
        {% for tag in product.tags %}<span class="text-xs border border-stone rounded-full px-3 py-1">{{ tag }}</span>{% endfor %}
      </div>
      {% endif %}

      <div class="mt-8 border-t border-stone pt-6 grid gap-4">
        <details class="group">
          <summary class="flex items-center justify-between cursor-pointer list-none">
            <span class="text-sm font-medium">Details</span><i class="ri-add-line group-open:hidden"></i><i class="ri-subtract-line hidden group-open:block"></i>
          </summary>
          <div class="text-sm text-muted leading-relaxed mt-3">
            {% if product.description != blank %}{{ product.description }}{% else %}No additional details.{% endif %}
          </div>
        </details>
        <details class="group">
          <summary class="flex items-center justify-between cursor-pointer list-none">
            <span class="text-sm font-medium">Delivery</span><i class="ri-add-line group-open:hidden"></i><i class="ri-subtract-line hidden group-open:block"></i>
          </summary>
          <div class="text-sm text-muted leading-relaxed mt-3">Digital product — download links sent to your email immediately after payment. Lifetime access to re-download.</div>
        </details>
      </div>
    </div>
  </div>
</section>
{% schema %}{"name":"Main Product Clean","settings":[]}{% endschema %}
