<div class="bg-white border-b border-line">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-2.5">
    <nav class="flex items-center gap-1.5 text-xs text-muted">
      <a href="{{ routes.root_url }}" class="hover:text-ink">Home</a><i class="ri-arrow-right-s-line text-line"></i>
      <a href="{{ routes.collections_url }}/all" class="hover:text-ink">Ebooks</a><i class="ri-arrow-right-s-line text-line"></i>
      <span class="text-ink truncate font-medium">{{ product.title }}</span>
    </nav>
  </div>
</div>
<section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 mt-4">
  <div class="grid lg:grid-cols-12 gap-4">
    <div class="lg:col-span-5 bg-white rounded-2xl border border-line p-4">
      <div class="rounded-xl border border-line bg-paper p-4">
        {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 640 }}" alt="{{ product.title | escape }}" class="w-full h-auto object-contain max-h-[460px] mx-auto">{% else %}<div class="aspect-[3/4] bg-paper grid place-items-center rounded-xl"><i class="ri-image-line text-3xl text-muted"></i></div>{% endif %}
      </div>
      <div class="grid grid-cols-2 gap-3 mt-4">
        {% form 'product', product %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" name="add" class="w-full bg-white border border-line text-ink py-3 rounded-full font-bold flex items-center justify-center gap-2 hover:border-ink"><i class="ri-shopping-bag-line"></i> Add to Cart</button>
        {% endform %}
        {% form 'product', product %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" class="w-full bg-ink text-white py-3 rounded-full font-bold flex items-center justify-center gap-2 hover:bg-black">Buy Now <i class="ri-flashlight-fill text-gold"></i></button>
        {% endform %}
      </div>
      <div class="mt-3 flex items-center justify-center gap-2 text-xs text-muted"><i class="ri-shield-check-line"></i> Secure checkout • Razorpay • UPI • Cards</div>
    </div>
    <div class="lg:col-span-7 bg-white rounded-2xl border border-line p-6 sm:p-7">
      <div class="inline-flex items-center gap-2 text-xs"><span class="bg-ink text-white px-2 py-1 rounded-full font-bold">Bestseller</span><span class="text-leaf font-semibold">10% off with Bank Offer</span></div>
      <h1 class="font-serif text-2xl leading-tight mt-3">{{ product.title }}</h1>
      <div class="flex items-center gap-2 mt-2">
        <span class="bg-leaf text-white text-xs px-2 py-1 rounded-full flex items-center gap-1 font-bold">4.9 <i class="ri-star-fill text-[10px]"></i></span>
        <span class="text-sm text-muted">1,842 Ratings & 312 Reviews</span>
        <span class="hidden sm:inline-flex items-center gap-1 text-leaf text-sm font-medium"><i class="ri-verified-badge-line"></i> Assured</span>
      </div>
      <div class="flex items-baseline gap-3 mt-4">
        <span class="text-2xl font-bold">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}<span class="text-sm line-through text-muted">{{ product.compare_at_price | money }}</span><span class="text-sm text-leaf font-bold">{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}% off</span>{% endif %}
      </div>
      <div class="text-xs text-muted">Inclusive of all taxes • GST invoice available</div>
      {% if product.description != blank %}
      <div class="mt-6 border-t border-line pt-5">
        <h3 class="font-bold text-sm">About this ebook</h3>
        <div class="prose prose-sm max-w-none mt-2 text-sm leading-relaxed text-[#2b2b2b]">{{ product.description }}</div>
      </div>
      {% endif %}
      <div class="mt-6 grid grid-cols-2 gap-3 text-xs">
        <div class="flex gap-2 bg-paper border border-line rounded-xl p-3"><i class="ri-download-2-line text-ink text-lg"></i><span><b>Instant download</b><br>PDF + EPUB • Lifetime</span></div>
        <div class="flex gap-2 bg-paper border border-line rounded-xl p-3"><i class="ri-refund-2-line text-ink text-lg"></i><span><b>7-day replacement</b><br>30-day refund</span></div>
      </div>
      <div class="mt-6 border border-line rounded-xl p-4 bg-paper">
        <div class="text-sm font-bold">Available offers</div>
        <div class="mt-2 space-y-1.5 text-xs">
          <div class="flex gap-2"><i class="ri-price-tag-3-fill text-leaf"></i> <span><b>Bank Offer</b> 10% off on HDFC Bank • <a href="#" class="text-ink underline">T&C</a></span></div>
          <div class="flex gap-2"><i class="ri-price-tag-3-fill text-leaf"></i> <span><b>Special Price</b> Extra 40% off • <a href="#" class="text-ink underline">T&C</a></span></div>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}{"name":"Main Product Mavizio Clean","settings":[]}{% endschema %}
