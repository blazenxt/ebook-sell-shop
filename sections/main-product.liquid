{% comment %} TEST img_url large {% endcomment %}
<div class="bg-white border-b border-line">
  <div class="max-w-[1280px] mx-auto px-4 py-6 text-center">
    <div class="inline-flex bg-leafSoft text-leaf border border-leaf/10 px-3 py-1 rounded-full text-xs font-bold">TEST img_url large</div>
    <h1 class="font-serif text-3xl font-bold mt-4">{{ product.title }} — img_url</h1>
    <p class="text-muted mt-2">Price: {{ product.price | money }}</p>
    {% if product.featured_image %}<img src="{{ product.featured_image | img_url: 'large' }}" alt="test" class="w-full h-auto mt-4">{% endif %}
  </div>
</div>
{% schema %}{"name":"Main Product TEST","settings":[]}{% endschema %}
