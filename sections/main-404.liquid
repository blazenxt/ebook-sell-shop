<section class="max-w-[960px] mx-auto px-4 sm:px-6 lg:px-8 mt-4">
  <div class="bg-white rounded-2xl border border-line p-10 sm:p-16 text-center">
    <div class="w-16 h-16 rounded-2xl bg-paper border border-line grid place-items-center mx-auto"><i class="ri-error-warning-line text-2xl text-muted"></i></div>
    <h1 class="font-serif text-2xl font-bold mt-6">We couldn't find that page</h1>
    <p class="text-sm text-muted mt-2">Try searching or return home.</p>
    <form action="{{ routes.search_url }}" method="get" class="flex gap-2 max-w-[400px] mx-auto mt-6">
      <input type="search" name="q" placeholder="Search ebooks" class="flex-1 border border-line rounded-full px-4 py-2.5 text-sm focus:outline-none bg-paper">
      <button class="bg-ink text-white px-6 py-2.5 rounded-full text-sm font-bold">Search</button>
    </form>
    <div class="flex justify-center gap-3 mt-6">
      <a href="{{ routes.root_url }}" class="bg-ink text-white px-6 py-2.5 rounded-full text-sm font-bold">Home</a>
      <a href="{{ routes.collections_url }}/all" class="border border-line px-6 py-2.5 rounded-full text-sm font-bold bg-white">Shop</a>
    </div>
  </div>
</section>
{% schema %}{"name":"Main 404 Clean","settings":[]}{% endschema %}
