<section class="max-w-[720px] mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 text-center">
  <div class="text-[11px] tracking-[0.2em] text-muted">— 404</div>
  <h1 class="display text-[40px] sm:text-[54px] leading-[0.9] mt-3">Page not found</h1>
  <p class="text-sm text-muted leading-relaxed max-w-[480px] mx-auto mt-4">The page you’re looking for doesn’t exist or was moved.</p>
  <form action="{{ routes.search_url }}" method="get" class="flex gap-2 max-w-[460px] mx-auto mt-8">
    <input type="search" name="q" placeholder="Search titles" class="flex-1 bg-white border border-stone rounded-full px-5 py-3 text-sm focus:outline-none focus:border-ink/20">
    <button class="bg-ink text-paper px-6 py-3 rounded-full text-sm font-medium">Search</button>
  </form>
  <div class="flex justify-center gap-3 mt-6">
    <a href="{{ routes.root_url }}" class="bg-ink text-paper px-6 py-3 rounded-full text-sm font-medium">Back to home</a>
    <a href="{{ routes.collections_url }}/all" class="bg-white border border-stone px-6 py-3 rounded-full text-sm font-medium">All titles</a>
  </div>
</section>
{% schema %}{"name":"Main 404 Clean","settings":[]}{% endschema %}
