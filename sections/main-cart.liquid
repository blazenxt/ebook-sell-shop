<section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 mt-4">
  <div class="grid lg:grid-cols-12 gap-4">
    <div class="lg:col-span-8 bg-white rounded-2xl border border-line overflow-hidden">
      <div class="px-5 py-4 border-b border-line flex items-center justify-between bg-paper/50">
        <h1 class="font-bold flex items-center gap-2">My Cart <span class="bg-ink text-white text-xs px-2 py-0.5 rounded-full">{{ cart.item_count }}</span></h1>
        <span class="text-xs text-leaf bg-leafSoft border border-leaf/10 px-2.5 py-1 rounded-full font-bold hidden sm:inline">Instant • GST invoice</span>
      </div>
      {% if cart.item_count == 0 %}
        <div class="text-center py-16 px-6">
          <div class="w-16 h-16 rounded-2xl bg-paper border border-line grid place-items-center mx-auto"><i class="ri-shopping-bag-line text-2xl text-muted"></i></div>
          <div class="font-semibold mt-4">Your cart is empty!</div>
          <div class="text-sm text-muted">Add ebooks to get instant download</div>
          <a href="{{ routes.collections_url }}/all" class="inline-flex mt-4 bg-ink text-white px-6 py-2.5 rounded-full text-sm font-bold hover:bg-black">Shop now</a>
        </div>
      {% else %}
        <div class="divide-y divide-line">
          {% for item in cart.items %}
            <div class="flex gap-4 p-4 hover:bg-paper/50 transition">
              <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title }}" class="w-20 h-28 object-contain border border-line rounded-xl p-1 bg-paper shrink-0">
              <div class="flex-1 min-w-0">
                <a href="{{ item.url }}" class="text-sm leading-tight line-clamp-2 hover:text-ink font-medium">{{ item.product.title }}</a>
                <div class="text-xs text-muted mt-1">{{ item.variant.title }} • <span class="text-leaf font-bold">7-day replacement</span></div>
                <div class="flex items-baseline gap-2 mt-2"><span class="font-bold">{{ item.final_price | money }}</span>{% if item.original_price > item.final_price %}<span class="text-xs line-through text-muted">{{ item.original_price | money }}</span><span class="text-xs text-leaf bg-leafSoft border border-leaf/10 px-1.5 py-0.5 rounded-full font-bold">{{ item.original_price | minus: item.final_price | times: 100 | divided_by: item.original_price }}% off</span>{% endif %}</div>
                <div class="flex items-center gap-3 mt-3">
                  <div class="flex items-center gap-2 border border-line rounded-full overflow-hidden bg-white">
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" class="px-3 py-1 hover:bg-paper">−</a>
                    <span class="px-3 py-1 border-x border-line text-sm font-medium bg-paper">{{ item.quantity }}</span>
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" class="px-3 py-1 hover:bg-paper">+</a>
                  </div>
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="text-xs font-bold text-muted hover:text-ink uppercase tracking-wide">Remove</a>
                </div>
              </div>
              <div class="hidden sm:block text-xs text-leaf bg-leafSoft border border-leaf/10 px-2 py-1 rounded-full font-bold self-start">Free Delivery</div>
            </div>
          {% endfor %}
        </div>
        <div class="p-4 border-t border-line flex justify-between items-center bg-paper/30">
          <span class="text-xs text-muted">Continue shopping and save more with <b class="text-ink">MAVIZIO40</b></span>
          <a href="{{ routes.collections_url }}/all" class="bg-white border border-line text-ink px-5 py-2 rounded-full text-xs font-bold hover:bg-ink hover:text-white transition">Continue Shopping</a>
        </div>
      {% endif %}
    </div>
    {% if cart.item_count > 0 %}
    <div class="lg:col-span-4 space-y-4">
      <div class="bg-white rounded-2xl border border-line p-5">
        <div class="text-xs font-bold tracking-[0.12em] text-muted uppercase border-b border-line pb-3">Price Details</div>
        <div class="mt-3 space-y-3 text-sm">
          <div class="flex justify-between"><span class="text-muted">Price ({{ cart.item_count }} items)</span><span>{{ cart.total_price | money }}</span></div>
          <div class="flex justify-between"><span class="text-muted">Discount</span><span class="text-leaf font-bold">— ₹0</span></div>
          <div class="flex justify-between"><span class="text-muted">Delivery</span><span class="text-leaf bg-leafSoft border border-leaf/10 px-2 py-0.5 rounded-full text-xs font-bold">FREE</span></div>
          <div class="flex justify-between font-bold border-t border-dashed border-line pt-3 text-base"><span>Total</span><span>{{ cart.total_price | money }}</span></div>
          <div class="text-xs text-leaf bg-leafSoft border border-leaf/10 rounded-full px-3 py-1.5 font-bold text-center">You save ₹0 on this order • Bank Offer applied</div>
        </div>
        <a href="/checkout" class="mt-4 flex justify-center bg-gold text-ink py-3 rounded-full font-bold hover:bg-goldDeep hover:text-white transition">Place Order — Secure <i class="ri-lock-2-fill ml-1"></i></a>
        <div class="mt-3 flex items-center justify-center gap-1.5 text-xs text-muted"><i class="ri-shield-check-fill text-leaf"></i> 100% Secure • Razorpay • UPI • Cards</div>
      </div>
      <div class="bg-cream border border-gold/20 rounded-2xl p-3 flex gap-2 text-xs"><i class="ri-gift-line text-gold text-lg shrink-0"></i><span><b>Add ₹200 more</b> to unlock <b>MAVIZIO40</b> — 40% off on 4 books</span></div>
    </div>
    {% endif %}
  </div>
</section>
{% schema %}{"name":"Main Cart Refined","settings":[]}{% endschema %}
