<section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 mt-4">
  <div class="grid lg:grid-cols-12 gap-4">
    <div class="lg:col-span-8 bg-white rounded-2xl border border-line">
      <div class="px-5 py-4 border-b border-line flex items-center justify-between">
        <h1 class="font-bold">My Cart ({{ cart.item_count }})</h1>
        <span class="text-xs text-muted hidden sm:inline">Instant delivery • GST invoice</span>
      </div>
      {% if cart.item_count == 0 %}
        <div class="text-center py-16 px-6">
          <div class="w-16 h-16 rounded-2xl bg-paper border border-line grid place-items-center mx-auto"><i class="ri-shopping-bag-line text-2xl text-muted"></i></div>
          <div class="font-semibold mt-4">Your cart is empty!</div>
          <div class="text-sm text-muted">Add ebooks to it now.</div>
          <a href="{{ routes.collections_url }}/all" class="inline-flex mt-4 bg-ink text-white px-6 py-2.5 rounded-full text-sm font-bold">Shop now</a>
        </div>
      {% else %}
        <div class="divide-y divide-line">
          {% for item in cart.items %}
            <div class="flex gap-4 p-4">
              <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title }}" class="w-20 h-28 object-contain border border-line rounded-xl p-1 bg-paper shrink-0">
              <div class="flex-1 min-w-0">
                <a href="{{ item.url }}" class="text-sm leading-tight line-clamp-2 hover:text-ink font-medium">{{ item.product.title }}</a>
                <div class="text-xs text-muted mt-1">{{ item.variant.title }}</div>
                <div class="flex items-baseline gap-2 mt-2"><span class="font-bold">{{ item.final_price | money }}</span>{% if item.original_price > item.final_price %}<span class="text-xs line-through text-muted">{{ item.original_price | money }}</span><span class="text-xs text-leaf font-bold">{{ item.original_price | minus: item.final_price | times: 100 | divided_by: item.original_price }}% off</span>{% endif %}</div>
                <div class="flex items-center gap-3 mt-3">
                  <div class="flex items-center gap-2 border border-line rounded-full overflow-hidden">
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" class="px-3 py-1 hover:bg-paper">−</a>
                    <span class="px-3 py-1 border-x border-line text-sm font-medium">{{ item.quantity }}</span>
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" class="px-3 py-1 hover:bg-paper">+</a>
                  </div>
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="text-xs font-bold text-muted hover:text-ink uppercase">Remove</a>
                </div>
              </div>
              <div class="hidden sm:block text-xs text-leaf font-medium">Instant • Free</div>
            </div>
          {% endfor %}
        </div>
        <div class="p-4 border-t border-line flex justify-end">
          <a href="{{ routes.collections_url }}/all" class="bg-white border border-line text-ink px-6 py-2.5 rounded-full text-sm font-bold">Continue Shopping</a>
        </div>
      {% endif %}
    </div>
    {% if cart.item_count > 0 %}
    <div class="lg:col-span-4 space-y-4">
      <div class="bg-white rounded-2xl border border-line p-5">
        <div class="text-xs font-bold tracking-wide text-muted uppercase border-b border-line pb-3">Price Details</div>
        <div class="mt-3 space-y-3 text-sm">
          <div class="flex justify-between"><span>Price ({{ cart.item_count }} items)</span><span>{{ cart.total_price | money }}</span></div>
          <div class="flex justify-between"><span>Delivery</span><span class="text-leaf font-bold">FREE</span></div>
          <div class="flex justify-between font-bold border-t border-dashed border-line pt-3"><span>Total</span><span>{{ cart.total_price | money }}</span></div>
          <div class="text-xs text-leaf font-medium">You save ₹0 on this order</div>
        </div>
        <a href="/checkout" class="mt-4 flex justify-center bg-gold text-ink py-3 rounded-full font-bold hover:brightness-95">Place Order</a>
        <div class="mt-3 flex items-center justify-center gap-1.5 text-xs text-muted"><i class="ri-lock-2-line"></i> 100% Secure • Razorpay • UPI</div>
      </div>
    </div>
    {% endif %}
  </div>
</section>
{% schema %}{"name":"Main Cart Clean","settings":[]}{% endschema %}
