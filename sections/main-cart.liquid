<div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-4">
  <nav class="flex items-center gap-2 text-xs font-semibold text-muted">
    <a href="{{ routes.root_url }}" class="hover:text-ink">Home</a> <i class="ri-arrow-right-s-line"></i> <span class="text-ink">Cart</span>
  </nav>
</div>

<section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 pb-12">
  <h1 class="display text-[30px] sm:text-[36px] leading-none">Your Cart</h1>
  {% if cart.item_count == 0 %}
    <div class="text-center py-16 bg-white border border-black/5 rounded-[24px] mt-8">
      <div class="w-20 h-20 bg-paper border border-black/5 rounded-full grid place-items-center mx-auto text-2xl text-muted"><i class="ri-shopping-bag-line text-3xl"></i></div>
      <div class="font-bold mt-4 text-lg">Your cart is empty</div>
      <div class="text-sm text-muted mt-1">Add some ebooks to get started</div>
      <a href="{{ routes.collections_url }}" class="inline-flex mt-6 bg-ink text-white px-6 py-3 rounded-full font-bold text-sm">Continue Shopping</a>
    </div>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <div class="grid lg:grid-cols-12 gap-6 mt-8">
        <div class="lg:col-span-8 space-y-4">
          {% for item in cart.items %}
            <div class="bg-white border border-black/5 rounded-[20px] p-4 flex gap-4">
              <a href="{{ item.url }}" class="w-[90px] sm:w-[110px] h-[120px] sm:h-[150px] rounded-xl overflow-hidden bg-paper border border-black/5 shrink-0">
                {% if item.image %}<img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.title }}" class="w-full h-full object-cover">{% endif %}
              </a>
              <div class="flex-1 min-w-0 flex flex-col">
                <a href="{{ item.url }}" class="font-bold leading-tight hover:underline line-clamp-2">{{ item.product.title }}</a>
                <div class="text-xs text-muted mt-1">{{ item.product.vendor }} • {{ item.variant.title | default: 'Digital' }}</div>
                <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-3">
                  <div class="flex items-center gap-2">
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" class="w-8 h-8 rounded-full bg-paper border border-black/10 grid place-items-center">−</a>
                    <span class="w-8 text-center font-bold">{{ item.quantity }}</span>
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" class="w-8 h-8 rounded-full bg-ink text-white grid place-items-center">+</a>
                  </div>
                  <div class="flex items-baseline gap-2">
                    <span class="text-[18px] font-extrabold">{{ item.final_line_price | money }}</span>
                    {% if item.original_line_price > item.final_line_price %}<span class="text-xs line-through text-muted">{{ item.original_line_price | money }}</span>{% endif %}
                  </div>
                </div>
                <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="text-xs font-bold text-red-500 hover:underline mt-2">Remove</a>
              </div>
            </div>
          {% endfor %}
        </div>
        <div class="lg:col-span-4">
          <div class="bg-white border border-black/5 rounded-[24px] p-6 sticky top-[88px]">
            <h3 class="font-bold text-lg">Order Summary</h3>
            <div class="mt-4 space-y-2 text-sm">
              <div class="flex justify-between"><span class="text-muted">Subtotal</span><span class="font-bold">{{ cart.items_subtotal_price | money }}</span></div>
              <div class="flex justify-between font-extrabold border-t border-black/5 pt-3"><span>Total</span><span>{{ cart.total_price | money }}</span></div>
              <div class="text-xs text-muted text-center">Tax included. Instant download after payment.</div>
            </div>
            <button type="submit" name="checkout" class="mt-5 w-full bg-gold text-ink py-3.5 rounded-full font-extrabold text-center flex items-center justify-center gap-2 hover:bg-yellow-400 transition">Checkout <i class="ri-lock-2-fill"></i></button>
            <a href="{{ routes.collections_url }}" class="mt-3 w-full bg-white border border-black/10 py-3 rounded-full font-bold text-center block">Continue Shopping</a>
          </div>
        </div>
      </div>
    </form>
  {% endif %}
</section>

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}
