<section class="max-w-[960px] mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
  <h1 class="display text-[30px] sm:text-[36px] leading-none">Cart</h1>
  {% if cart.item_count == 0 %}
    <div class="mt-8 bg-white border border-stone rounded-[20px] p-10 text-center">
      <div class="w-12 h-12 border border-stone rounded-full grid place-items-center mx-auto"><i class="ri-shopping-bag-line"></i></div>
      <div class="font-medium mt-4">Your cart is empty</div>
      <div class="text-sm text-muted mt-1">Add some titles to get started.</div>
      <a href="{{ routes.collections_url }}/all" class="inline-flex mt-6 bg-ink text-paper px-6 py-3 rounded-full text-sm">Continue shopping</a>
    </div>
  {% else %}
    <div class="mt-8 grid lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-8 space-y-4">
        {% for item in cart.items %}
          <div class="flex gap-4 bg-white border border-stone rounded-[20px] p-4">
            <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title }}" class="w-20 h-28 object-cover rounded-xl border border-stone bg-sand shrink-0">
            <div class="flex-1 min-w-0">
              <a href="{{ item.url }}" class="text-sm font-medium leading-tight line-clamp-2">{{ item.product.title }}</a>
              <div class="text-xs text-muted mt-1">{{ item.variant.title }}</div>
              <div class="text-sm font-semibold mt-2">{{ item.final_price | money }}</div>
              <div class="flex items-center gap-2 mt-3">
                <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" class="w-8 h-8 rounded-full border border-stone grid place-items-center hover:bg-paper">−</a>
                <span class="w-8 text-center text-sm font-medium">{{ item.quantity }}</span>
                <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" class="w-8 h-8 rounded-full bg-ink text-paper grid place-items-center">+</a>
                <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="ml-auto text-xs text-muted hover:text-ink border-b border-transparent hover:border-ink">Remove</a>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
      <div class="lg:col-span-4 lg:sticky lg:top-[88px]">
        <div class="bg-white border border-stone rounded-[20px] p-6">
          <div class="flex justify-between text-sm"><span class="text-muted">Subtotal</span><span class="font-semibold">{{ cart.total_price | money }}</span></div>
          <div class="text-xs text-muted mt-2">Taxes and shipping calculated at checkout. Digital products — no shipping.</div>
          <a href="/checkout" class="mt-6 flex justify-center bg-ink text-paper py-3.5 rounded-full text-sm font-medium hover:bg-black transition">Checkout</a>
          <a href="{{ routes.collections_url }}/all" class="mt-3 flex justify-center bg-white border border-stone py-3.5 rounded-full text-sm font-medium">Continue shopping</a>
        </div>
      </div>
    </div>
  {% endif %}
</section>
{% schema %}{"name":"Main Cart Clean","settings":[]}{% endschema %}
