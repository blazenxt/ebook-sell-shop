<section class="max-w-[960px] mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="display text-[30px] text-white">Cart</h1>
  {% if cart.item_count == 0 %}
    <div class="mt-8 bg-[#141414] border border-white/10 rounded-[12px] p-10 text-center">
      <div class="text-white/50">Your cart is empty</div>
      <a href="{{ routes.collections_url }}/all" class="inline-flex mt-4 bg-[#FFB800] text-black px-6 py-3 rounded-md text-sm font-bold">Continue shopping</a>
    </div>
  {% else %}
    <div class="mt-8 space-y-4">
      {% for item in cart.items %}
        <div class="flex gap-4 bg-[#141414] border border-white/10 rounded-[12px] p-4">
          <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title }}" class="w-20 h-28 object-cover rounded-md bg-[#1A1A1A] shrink-0">
          <div class="flex-1 min-w-0 text-white">
            <div class="text-sm font-medium">{{ item.product.title }}</div>
            <div class="text-xs text-white/50">{{ item.variant.title }}</div>
            <div class="text-sm font-bold text-[#FFB800] mt-2">{{ item.final_price | money }}</div>
            <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="text-xs text-white/50 underline">Remove</a>
          </div>
        </div>
      {% endfor %}
      <div class="bg-[#141414] border border-white/10 rounded-[12px] p-6">
        <div class="flex justify-between text-white"><span>Subtotal</span><span class="font-bold text-[#FFB800]">{{ cart.total_price | money }}</span></div>
        <a href="/checkout" class="mt-4 flex justify-center bg-[#FFB800] text-black py-3 rounded-md font-bold">Checkout</a>
      </div>
    </div>
  {% endif %}
</section>
{% schema %}{"name":"Main Cart Luxury","settings":[]}{% endschema %}
