<footer class="border-t border-black/5 bg-white">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid md:grid-cols-4 gap-8 text-sm">
      <div>
        <div class="flex items-center gap-2"><div class="w-8 h-8 bg-ink text-gold rounded-lg grid place-items-center"><i class="ri-book-open-line"></i></div><span class="display text-lg">Mavizio.</span></div>
        <p class="text-muted leading-relaxed mt-3">India's digital bookstore. Instant download, lifetime access. GSTIN: 22ABCDE1234F1Z5</p>
        <div class="flex gap-2 mt-4 text-lg text-muted"><i class="ri-instagram-line hover:text-ink cursor-pointer"></i><i class="ri-twitter-x-line hover:text-ink cursor-pointer"></i><i class="ri-youtube-line hover:text-ink cursor-pointer"></i><i class="ri-linkedin-line hover:text-ink cursor-pointer"></i></div>
      </div>
      <div><div class="font-bold">Shop</div><div class="mt-3 space-y-2 text-muted"><a href="{{ routes.collections_url }}" class="block hover:text-ink">All Ebooks</a><a href="{{ routes.collections_url }}" class="block hover:text-ink">Bestsellers</a><a href="{{ routes.collections_url }}" class="block hover:text-ink">Bundles</a></div></div>
      <div><div class="font-bold">Help</div><div class="mt-3 space-y-2 text-muted"><a href="{{ routes.account_url }}" class="block hover:text-ink">My Downloads</a><a href="{{ pages.contact.url }}" class="block hover:text-ink">Contact</a><a href="{{ pages.about.url }}" class="block hover:text-ink">About</a><a href="#" class="block hover:text-ink flex items-center gap-1"><i class="ri-whatsapp-line text-green-600"></i> WhatsApp Support</a></div></div>
      <div><div class="font-bold">Payments</div><div class="flex flex-wrap gap-2 mt-3"><span class="bg-paper border border-black/10 px-3 py-2 rounded-xl text-xs font-bold">Razorpay</span><span class="bg-paper border border-black/10 px-3 py-2 rounded-xl text-xs font-bold">UPI</span><span class="bg-paper border border-black/10 px-3 py-2 rounded-xl text-xs font-bold">Cards</span></div><div class="text-xs text-muted mt-3 flex items-center gap-1.5"><i class="ri-lock-2-fill text-green-600"></i> 100% secure • Instant GST invoice</div></div>
    </div>
    <div class="mt-8 pt-6 border-t border-black/5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-muted">
      <span class="flex items-center gap-1">© {{ 'now' | date: '%Y' }} Mavizio Store. Made with <i class="ri-heart-3-fill text-red-500"></i> by <a href="https://blazenxt.github.io" target="_blank" rel="noopener" class="hover:text-ink underline font-bold">BlazeNXT</a></span>
      <span class="flex gap-4"><a href="{{ pages.privacy-policy.url }}" class="hover:text-ink">Privacy</a><a href="{{ pages.terms.url | default: '#' }}" class="hover:text-ink">Terms</a><a href="#" class="hover:text-ink">Refund</a></span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
