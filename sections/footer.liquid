<footer class="border-t border-stone bg-white">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
    <div class="grid md:grid-cols-12 gap-8">
      <div class="md:col-span-5">
        <div class="display text-xl">Mavizio<span class="text-muted">.</span></div>
        <p class="text-sm text-muted leading-relaxed mt-3 max-w-[360px]">Curated ebooks. Instant download, lifetime access. Designed in India for readers who value clarity.</p>
      </div>
      <div class="md:col-span-3">
        <div class="text-xs tracking-[0.18em] text-muted">SHOP</div>
        <div class="mt-3 space-y-2 text-sm">
          <a href="{{ routes.collections_url }}/all" class="block hover:opacity-60">All titles</a>
          <a href="{{ routes.collections_url }}" class="block hover:opacity-60">Collections</a>
          <a href="{{ routes.search_url }}" class="block hover:opacity-60">Search</a>
        </div>
      </div>
      <div class="md:col-span-4">
        <div class="text-xs tracking-[0.18em] text-muted">NEWSLETTER</div>
        <p class="text-sm text-muted mt-2">New releases, no spam.</p>
        {% form 'customer' %}
          <div class="flex gap-2 mt-3 max-w-[320px]">
            <input type="email" name="contact[email]" placeholder="you@email.com" required class="flex-1 bg-paper border border-stone rounded-full px-4 py-2.5 text-sm focus:outline-none focus:border-ink/20">
            <button type="submit" class="bg-ink text-paper px-5 py-2.5 rounded-full text-sm font-medium">Join</button>
          </div>
        {% endform %}
        <div class="flex gap-3 mt-5 text-muted">
          <a href="https://instagram.com" target="_blank" aria-label="Instagram"><i class="ri-instagram-line"></i></a>
          <a href="https://twitter.com" target="_blank" aria-label="X"><i class="ri-twitter-x-line"></i></a>
        </div>
      </div>
    </div>
    <div class="mt-10 pt-6 border-t border-stone flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-muted">
      <span>© {{ 'now' | date: '%Y' }} Mavizio. Made with <i class="ri-heart-3-fill text-red-500"></i> by <a href="https://blazenxt.github.io" target="_blank" class="underline hover:text-ink">BlazeNXT</a></span>
      <span class="flex gap-4">
        {% if pages.privacy-policy %}<a href="{{ pages.privacy-policy.url }}" class="hover:text-ink">Privacy</a>{% endif %}
        <a href="/policies/refund-policy" class="hover:text-ink">Refund</a>
        <a href="/policies/terms-of-service" class="hover:text-ink">Terms</a>
      </span>
    </div>
  </div>
</footer>
{% schema %}{"name":"Footer Atelier","settings":[]}{% endschema %}
