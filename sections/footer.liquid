<footer class="bg-ink text-white mt-6">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 text-sm">
      <div>
        <div class="font-serif text-lg font-bold">MAVIZIO<span class="text-gold">.</span></div>
        <p class="text-white/60 text-xs leading-relaxed mt-2">Ebooks that feel like real books. Instant, lifetime, GST-ready. Built for readers who do.</p>
        <div class="flex items-center gap-2 mt-4">
          <a href="#" class="w-8 h-8 rounded-full bg-white/10 grid place-items-center hover:bg-gold hover:text-ink transition"><i class="ri-instagram-line"></i></a>
          <a href="#" class="w-8 h-8 rounded-full bg-white/10 grid place-items-center hover:bg-gold hover:text-ink transition"><i class="ri-twitter-x-line"></i></a>
          <a href="#" class="w-8 h-8 rounded-full bg-white/10 grid place-items-center hover:bg-gold hover:text-ink transition"><i class="ri-youtube-line"></i></a>
        </div>
      </div>
      <div>
        <div class="text-white/40 tracking-widest text-[11px] font-semibold">SHOP</div>
        <div class="mt-3 space-y-2 text-white/80 text-xs">
          <a href="{{ routes.collections_url }}/all" class="block hover:text-gold">All Titles</a>
          <a href="{{ routes.collections_url }}/all" class="block hover:text-gold">Bestsellers</a>
          <a href="{{ routes.collections_url }}/all" class="block hover:text-gold">New Releases</a>
          <a href="{{ routes.search_url }}" class="block hover:text-gold">Search</a>
        </div>
      </div>
      <div>
        <div class="text-white/40 tracking-widest text-[11px] font-semibold">COMPANY</div>
        <div class="mt-3 space-y-2 text-white/80 text-xs">
          <a href="{{ pages.about.url | default: '/pages/about' }}" class="block hover:text-gold">About Us</a>
          <a href="{{ pages.contact.url | default: '/pages/contact' }}" class="block hover:text-gold">Contact</a>
          <a href="#" class="block hover:text-gold">Careers</a>
          <a href="https://blazenxt.github.io" target="_blank" class="block hover:text-gold">ANKIT</a>
        </div>
      </div>
      <div>
        <div class="text-white/40 tracking-widest text-[11px] font-semibold">LEGAL</div>
        <div class="mt-3 space-y-2 text-white/80 text-xs">
          <a href="{{ pages['privacy-policy'].url | default: '/policies/privacy-policy' }}" class="block hover:text-gold">Privacy Policy</a>
          <a href="{{ pages['terms-of-service'].url | default: '/policies/terms-of-service' }}" class="block hover:text-gold">Terms of Use</a>
          <a href="{{ pages['refund-policy'].url | default: '/policies/refund-policy' }}" class="block hover:text-gold">Refund Policy</a>
          <a href="{{ pages['shipping-policy'].url | default: '/policies/shipping-policy' }}" class="block hover:text-gold">Shipping Policy</a>
        </div>
      </div>
      <div class="col-span-2 md:col-span-1">
        <div class="text-white/40 tracking-widest text-[11px] font-semibold">NEWSLETTER</div>
        <p class="text-white/60 text-xs mt-3">Get 10% off your first order.</p>
        {% form 'customer', class: 'mt-3 flex' %}
          <input type="email" name="contact[email]" placeholder="you@email.com" required class="flex-1 bg-white/10 border border-white/20 rounded-l-full px-3 py-2 text-xs placeholder:text-white/50 focus:outline-none">
          <button type="submit" class="bg-gold text-ink px-4 rounded-r-full text-xs font-bold">Join</button>
        {% endform %}
        <div class="mt-4 flex flex-wrap gap-1.5 text-[11px]"><span class="bg-white text-ink px-2 py-1 rounded-full font-bold">Razorpay</span><span class="bg-white text-ink px-2 py-1 rounded-full font-bold">UPI</span><span class="bg-white text-ink px-2 py-1 rounded-full font-bold">Cards</span><span class="border border-white/20 px-2 py-1 rounded-full">100% Secure</span></div>
      </div>
    </div>
    <div class="mt-8 pt-6 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-3 text-xs text-white/60">
      <div>© {{ 'now' | date: '%Y' }} Mavizio. Made with ♥ by <a href="https://mavizio.xyz/" target="_blank" class="text-gold hover:underline">BlazeNXT</a></div>
      <div class="flex items-center gap-3"><span class="hidden sm:inline">Payments:</span><span class="bg-white text-ink px-2 py-1 rounded-full font-bold text-[11px]">VISA • MC • UPI</span></div>
    </div>
  </div>
</footer>
{% schema %}{"name":"Footer Mavizio Clean","settings":[]}{% endschema %}
