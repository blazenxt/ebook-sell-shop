<section class="max-w-[980px] mx-auto px-4 sm:px-6 lg:px-8 mt-8">
  <div class="text-center">
    <div class="inline-flex items-center gap-2 bg-cream border border-black/5 rounded-full px-3 py-1 text-xs font-bold tracking-wide">WHY MAVIZIO?</div>
    <h2 class="display text-[28px] sm:text-[36px] leading-none mt-2 font-extrabold">Why 50k+ choose us <span class="text-muted font-normal">over random PDFs</span></h2>
  </div>
  <div class="mt-6 bg-white border border-black/5 rounded-[24px] overflow-hidden">
    <div class="grid grid-cols-12 text-[11px] tracking-[0.15em] font-bold text-muted border-b border-black/5 bg-paper/50">
      <div class="col-span-6 sm:col-span-7 px-5 py-3">FEATURE</div>
      <div class="col-span-3 sm:col-span-2 px-3 py-3 text-center bg-ink text-gold">MAVIZIO</div>
      <div class="col-span-3 sm:col-span-3 px-3 py-3 text-center">OTHERS</div>
    </div>
    {% assign rows = "Instant download (10 sec):✓:✗;PDF+EPUB+MOBI+Audio:✓:PDF only;Lifetime free updates:✓:✗;30-day refund:✓:✗;Mobile/Kindle ready:✓:~;UPI/Razorpay:✓:✓" | split: ";" %}
    {% for r in rows %}
      {% assign c = r | split: ":" %}
      <div class="grid grid-cols-12 text-sm border-b border-black/5 last:border-0">
        <div class="col-span-6 sm:col-span-7 px-5 py-3.5 font-medium">{{ c[0] }}</div>
        <div class="col-span-3 sm:col-span-2 px-3 py-3.5 text-center bg-ink/5 font-bold text-ink flex justify-center items-center gap-1">{% if c[1] == '✓' %}<i class="ri-checkbox-circle-fill text-green-600"></i> {{ c[1] }}{% else %}{{ c[1] }}{% endif %}</div>
        <div class="col-span-3 sm:col-span-3 px-3 py-3.5 text-center text-muted">{{ c[2] }}</div>
      </div>
    {% endfor %}
  </div>
  <div class="text-center mt-4 text-xs text-muted">No subscription. One payment, lifetime. GST invoice included.</div>
</section>
{% schema %}{"name":"Comparison","settings":[]}{% endschema %}
