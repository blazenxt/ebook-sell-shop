<header class="sticky top-0 z-40 bg-[#0A0A0A] border-b border-white/10">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-[64px] gap-6">
      <a href="{{ routes.root_url }}" class="flex items-center gap-8">
        <span class="brand text-[22px] font-light tracking-[0.15em] text-[#FFB800]">MAVIZIO</span>
        <nav class="hidden lg:flex items-center gap-6 text-[13px] text-white/80">
          <a href="{{ routes.collections_url }}/all" class="hover:text-[#FFB800] transition">New Arrivals</a>
          <a href="{{ routes.collections_url }}/all" class="hover:text-[#FFB800] transition">Bestsellers</a>
          <a href="{{ routes.collections_url }}" class="hover:text-[#FFB800] transition">Collections</a>
          <a href="{{ routes.collections_url }}" class="hover:text-[#FFB800] transition">Genres</a>
          <a href="{{ pages.about.url | default: '#' }}" class="hover:text-[#FFB800] transition">About</a>
        </nav>
      </a>
      <div class="flex items-center gap-4 text-[#FFB800]">
        <a href="{{ routes.search_url }}" class="w-8 h-8 grid place-items-center hover:text-white transition"><i class="ri-search-line text-lg"></i></a>
        <a href="{{ routes.account_url }}" class="w-8 h-8 grid place-items-center hover:text-white transition hidden sm:grid"><i class="ri-user-line text-lg"></i></a>
        <a href="{{ routes.cart_url }}" class="flex items-center gap-1.5 hover:text-white transition">
          <i class="ri-shopping-bag-line text-lg"></i><span class="text-sm text-white">{{ cart.item_count }}</span>
        </a>
        <button class="lg:hidden w-8 h-8 grid place-items-center text-white/80"><i class="ri-menu-line text-xl"></i></button>
      </div>
    </div>
  </div>
</header>
{% schema %}{"name":"Header Luxury","settings":[]}{% endschema %}
