<header class="sticky top-0 z-40 bg-paper/80 backdrop-blur-xl border-b border-stone">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-[68px] gap-6">
      <a href="{{ routes.root_url }}" class="flex items-center gap-3 shrink-0">
        <span class="w-9 h-9 border border-ink rounded-full grid place-items-center text-sm">—</span>
        <span class="display text-[22px] leading-none tracking-tight">{{ section.settings.logo_text | default: 'Mavizio' }}</span>
        <span class="hidden sm:inline text-[10px] tracking-[0.2em] text-muted border border-stone rounded-full px-2 py-1">ATELIER</span>
      </a>
      <nav class="hidden lg:flex items-center gap-7 text-[13px] font-medium">
        <a href="{{ routes.collections_url }}/all" class="hover:opacity-60 transition">Shop</a>
        <a href="{{ routes.collections_url }}" class="hover:opacity-60 transition">Collections</a>
        <a href="{{ routes.search_url }}" class="hover:opacity-60 transition">Search</a>
        {% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}" class="hover:opacity-60 transition">Account</a>{% endif %}
      </nav>
      <div class="flex items-center gap-2">
        <form action="{{ routes.search_url }}" method="get" class="hidden md:flex relative">
          <input type="search" name="q" placeholder="Search" class="bg-white border border-stone rounded-full pl-9 pr-4 py-2 text-sm w-[200px] focus:outline-none focus:border-ink/20">
          <i class="ri-search-line absolute left-3 top-1/2 -translate-y-1/2 text-muted text-sm"></i>
        </form>
        <a href="{{ routes.cart_url }}" class="flex items-center gap-2 border border-ink rounded-full pl-2 pr-3 py-1.5 hover:bg-ink hover:text-paper transition">
          <span class="text-sm"><i class="ri-shopping-bag-line"></i></span>
          <span class="text-xs font-medium hidden sm:inline">Cart</span>
          <span class="bg-ink text-paper group-hover:bg-paper group-hover:text-ink text-xs font-bold w-5 h-5 grid place-items-center rounded-full border border-ink">{{ cart.item_count }}</span>
        </a>
      </div>
    </div>
  </div>
</header>
{% schema %}{"name":"Header","settings":[{"type":"text","id":"logo_text","label":"Logo","default":"Mavizio"}]}{% endschema %}
