<section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 mt-8 sm:mt-12">
  <div class="border-b border-white/10 pb-3">
    <h2 class="text-[11px] tracking-[0.2em] text-white/60">FEATURED NEW RELEASES</h2>
    <div class="w-[160px] h-[1px] bg-[#FFB800] mt-2"></div>
  </div>

  {% assign col = collections[section.settings.collection] %}
  {% if col == blank %}{% assign col = collections.all %}{% endif %}

  {% if col.products_count > 0 %}
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mt-6">
    {% for product in col.products limit: section.settings.products_to_show %}
      <div class="bg-[#141414] border border-white/10 rounded-[12px] overflow-hidden card flex flex-col">
        <div class="relative p-3 pb-0">
          <div class="absolute top-4 left-0 z-10 bg-[#FFB800] text-black text-[11px] font-bold px-3 py-1 flex items-center" style="clip-path: polygon(0 0, 90% 0, 100% 50%, 90% 100%, 0 100%);">
            NEW RELEASE
          </div>
          <div class="aspect-[3/4] rounded-[8px] overflow-hidden bg-[#1A1A1A] mt-2">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" class="w-full h-full object-cover">
            {% else %}
              <div class="w-full h-full grid place-items-center bg-gradient-to-br from-[#1A1A1A] to-[#2A2A2A] p-4 text-center">
                <div class="text-white font-bold text-sm leading-tight">{{ product.title | truncate: 24 }}</div>
              </div>
            {% endif %}
          </div>
        </div>
        <div class="p-4 flex-1 flex flex-col">
          <div class="text-sm font-medium leading-tight text-white line-clamp-2 min-h-[2.5em]">{{ product.title }}</div>
          <div class="text-xs text-white/50 mt-1">{{ product.vendor | default: 'Elias Thorne' }}</div>
          <div class="text-sm font-bold text-[#FFB800] mt-2">{{ product.price | money }}</div>
          {% form 'product', product %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <button type="submit" class="w-full mt-3 border border-[#FFB800]/50 text-[#FFB800] rounded-md py-2 text-xs font-bold hover:bg-[#FFB800] hover:text-black transition">Add to Cart</button>
          {% endform %}
        </div>
      </div>
    {% endfor %}
  </div>
  {% else %}
    <div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {% for i in (1..4) %}
        <div class="bg-[#141414] border border-white/10 rounded-[12px] p-8 text-center">
          <div class="w-12 h-12 border border-[#FFB800]/30 rounded-full grid place-items-center mx-auto text-[#FFB800]"><i class="ri-book-line"></i></div>
          <div class="text-sm text-white/70 mt-3">Add products to display</div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</section>
{% schema %}{"name":"Featured Luxury","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","min":4,"max":12,"step":4,"default":4,"label":"Products to show"}]}{% endschema %}
