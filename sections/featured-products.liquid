<section id="bestsellers" class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 mt-10 sm:mt-14">
  <div class="flex items-end justify-between gap-6 border-b border-stone pb-4">
    <div>
      <div class="text-[11px] tracking-[0.2em] text-muted">— SELECTED</div>
      <h2 class="display text-[28px] sm:text-[36px] leading-none mt-1">{{ section.settings.heading | default: 'Recent titles' }}</h2>
      {% if section.settings.subheading != blank %}<p class="text-sm text-muted mt-2">{{ section.settings.subheading }}</p>{% endif %}
    </div>
    <a href="{{ routes.collections_url }}/all" class="hidden sm:inline-flex items-center gap-1 text-sm font-medium border-b border-ink pb-1 hover:opacity-60">All titles <i class="ri-arrow-right-line"></i></a>
  </div>

  {% assign col = collections[section.settings.collection] %}
  {% if col == blank %}{% assign col = collections.all %}{% endif %}

  {% if col.products_count > 0 %}
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mt-6">
    {% for product in col.products limit: section.settings.products_to_show %}
      <a href="{{ product.url }}" class="group flex flex-col">
        <div class="aspect-[3/4] overflow-hidden rounded-[20px] border border-stone bg-sand">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="w-full h-full object-cover group-hover:scale-[1.02] transition duration-700">
          {% else %}
            <div class="w-full h-full grid place-items-center text-muted"><i class="ri-image-line text-2xl"></i></div>
          {% endif %}
        </div>
        <div class="pt-4 flex-1 flex flex-col">
          <div class="text-[11px] tracking-[0.18em] text-muted">{{ product.type | default: product.product_type | default: 'Ebook' | upcase }}{% if product.vendor != blank %} • {{ product.vendor | upcase }}{% endif %}</div>
          <div class="font-medium leading-tight mt-1 line-clamp-2">{{ product.title }}</div>
          {% if product.description != blank %}<div class="text-xs text-muted mt-1 line-clamp-2">{{ product.description | strip_html | truncate: 90 }}</div>{% endif %}
          <div class="flex items-baseline gap-2 mt-3">
            <span class="font-semibold">{{ product.price | money }}</span>
            {% if product.compare_at_price > product.price %}<span class="text-xs text-muted line-through">{{ product.compare_at_price | money }}</span>{% endif %}
          </div>
          {% if product.tags.size > 0 %}
          <div class="flex flex-wrap gap-1.5 mt-3">
            {% for tag in product.tags limit: 2 %}<span class="text-[11px] border border-stone rounded-full px-2 py-1">{{ tag }}</span>{% endfor %}
          </div>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
  {% else %}
    <div class="mt-8 bg-white border border-stone rounded-[20px] p-10 text-center">
      <div class="text-sm font-medium">No products yet</div>
      <div class="text-sm text-muted mt-1">Add products to <b>{{ col.title }}</b> in Shopify Admin → Products.</div>
      <a href="{{ routes.collections_url }}/all" class="inline-flex mt-4 bg-ink text-paper px-5 py-2.5 rounded-full text-sm">View collections</a>
    </div>
  {% endif %}

  {% if section.settings.show_bundle and col.products_count >= 4 %}
  <div class="mt-8 border border-stone rounded-[20px] p-5 sm:p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div>
      <div class="text-sm font-semibold">Bundle — any 4 titles</div>
      <div class="text-sm text-muted">Select 4 and save at checkout. No code needed.</div>
    </div>
    <a href="{{ routes.collections_url }}/all" class="bg-ink text-paper px-6 py-3 rounded-full text-sm font-medium hover:bg-black transition">Build your bundle</a>
  </div>
  {% endif %}
</section>
{% schema %}{"name":"Featured Products Clean","settings":[{"type":"text","id":"heading","label":"Heading","default":"Recent titles"},{"type":"text","id":"subheading","label":"Subheading","default":""},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","min":4,"max":12,"step":4,"default":8,"label":"Products to show"},{"type":"checkbox","id":"show_bundle","label":"Show bundle callout","default":false}]}{% endschema %}
