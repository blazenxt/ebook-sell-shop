<section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 mt-4">
  <div class="bg-white rounded-2xl border border-line overflow-hidden">
    <div class="flex items-center justify-between px-4 sm:px-6 py-4 border-b border-line">
      <div>
        <h2 class="font-serif text-xl font-bold leading-none">Best of Mavizio</h2>
        <p class="text-xs text-muted mt-1">Inspired by Flipkart's deals grid — but 100% our design</p>
      </div>
      <a href="{{ routes.collections_url }}/all" class="hidden sm:inline-flex items-center gap-1 bg-ink text-white px-4 py-2 rounded-full text-xs font-bold">View All <i class="ri-arrow-right-line"></i></a>
    </div>

    {% assign col = collections[section.settings.collection] %}
    {% if col == blank %}{% assign col = collections.all %}{% endif %}

    {% if col.products_count > 0 %}
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 divide-x divide-y divide-line border-t border-line">
      {% for product in col.products limit: section.settings.products_to_show %}
        <a href="{{ product.url }}" class="group bg-white p-3 sm:p-4 flex flex-col mv-card">
          <div class="aspect-[3/4] rounded-xl overflow-hidden bg-paper border border-line p-2 flex items-center justify-center">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 360 }}" alt="{{ product.title | escape }}" class="max-h-full max-w-full object-contain group-hover:scale-105 transition duration-500">
            {% else %}
              <div class="w-full h-full grid place-items-center text-muted"><i class="ri-book-line text-2xl"></i></div>
            {% endif %}
          </div>
          <div class="mt-3 flex-1 flex flex-col">
            <div class="text-[11px] tracking-wide text-muted truncate">{{ product.vendor | default: 'Mavizio Originals' }}</div>
            <div class="text-sm leading-tight line-clamp-2 min-h-[2.6em] mt-1 font-medium">{{ product.title }}</div>
            <div class="flex items-center gap-1.5 mt-2">
              <span class="bg-leaf text-white text-xs px-1.5 py-0.5 rounded-full flex items-center gap-0.5 font-bold">4.9 <i class="ri-star-fill text-[10px]"></i></span>
              <span class="text-xs text-muted">(1,842)</span>
            </div>
            <div class="flex items-baseline gap-2 mt-2">
              <span class="font-bold text-sm">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}<span class="text-xs line-through text-muted">{{ product.compare_at_price | money }}</span>{% endif %}
            </div>
            {% if product.compare_at_price > product.price %}<div class="text-xs text-leaf font-bold mt-0.5">{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}% off • Bank Offer</div>{% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
    <div class="px-4 sm:px-6 py-3 bg-paper border-t border-line flex items-center justify-between text-xs">
      <span class="text-muted">Free instant download • Lifetime access • GST invoice</span>
      <a href="{{ routes.collections_url }}/all" class="sm:hidden font-bold text-ink">View All →</a>
    </div>
    {% else %}
      <div class="text-center py-12 px-6">
        <div class="w-12 h-12 rounded-full bg-paper border border-line grid place-items-center mx-auto"><i class="ri-inbox-line text-xl text-muted"></i></div>
        <div class="text-sm font-semibold mt-3">No products yet</div>
        <div class="text-xs text-muted mt-1">Add products in Shopify Admin → Products to fill this grid (not fake data).</div>
        <a href="{{ routes.collections_url }}/all" class="inline-flex mt-4 border border-line px-4 py-2 rounded-full text-xs font-bold">Browse Collections</a>
      </div>
    {% endif %}
  </div>
</section>
{% schema %}{"name":"Featured Mavizio","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","min":4,"max":12,"step":2,"default":6,"label":"Products to show"}]}{% endschema %}
