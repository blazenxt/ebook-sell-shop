<section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-12">
  <div class="grid lg:grid-cols-12 gap-6 lg:gap-8 items-start border-b border-stone pb-8 sm:pb-12">
    <div class="lg:col-span-7">
      <div class="text-[11px] tracking-[0.2em] text-muted">— EST. 2024 • INDIA</div>
      <h1 class="display text-[40px] sm:text-[56px] lg:text-[64px] leading-[0.9] mt-3">
        {{ section.settings.heading | default: 'A library' }}<br>
        <span class="serif italic font-light">{{ section.settings.subheading | default: 'for the curious.' }}</span>
      </h1>
      <p class="text-[15px] leading-relaxed text-muted max-w-[560px] mt-5">
        {{ section.settings.description | default: shop.description | default: 'Curated ebooks for business, self-help, fiction and competitive exams. Instant download, lifetime access. No shipping, no waiting.' }}
      </p>
      <div class="flex flex-wrap gap-3 mt-8">
        <a href="{{ routes.collections_url }}/all" class="inline-flex items-center gap-2 bg-ink text-paper px-6 py-3 rounded-full text-sm font-medium hover:bg-black transition">Explore collection <i class="ri-arrow-right-line"></i></a>
        <a href="#collection" class="inline-flex items-center gap-2 bg-white border border-stone px-6 py-3 rounded-full text-sm font-medium hover:border-ink/20 transition">Browse topics</a>
      </div>
      {% if shop.description != blank %}
      <div class="mt-8 pt-6 border-t border-stone/50 flex items-center gap-3 text-xs text-muted">
        <span class="w-2 h-2 bg-ink rounded-full"></span> {{ collections.size }} collections • {{ collections.all.products_count }} titles
      </div>
      {% endif %}
    </div>
    <div class="lg:col-span-5">
      {% assign p = all_products[section.settings.featured_product] %}
      {% if p == blank %}{% assign p = collections.all.products.first %}{% endif %}
      {% if p %}
        <a href="{{ p.url }}" class="group block bg-white border border-stone rounded-[24px] overflow-hidden card">
          {% if p.featured_image %}
            <div class="aspect-[4/3] overflow-hidden bg-sand">
              <img src="{{ p.featured_image | image_url: width: 700 }}" alt="{{ p.title }}" class="w-full h-full object-cover group-hover:scale-[1.02] transition duration-700">
            </div>
          {% endif %}
          <div class="p-5 sm:p-6">
            <div class="text-[11px] tracking-[0.18em] text-muted">FEATURED • {{ p.type | default: 'Ebook' | upcase }}</div>
            <div class="display text-[20px] leading-tight mt-2">{{ p.title }}</div>
            <div class="text-sm text-muted mt-1">{{ p.vendor }}{% if p.metafields.custom.author != blank %} • {{ p.metafields.custom.author }}{% endif %}</div>
            <div class="flex items-baseline gap-3 mt-4">
              <span class="text-xl font-semibold">{{ p.price | money }}</span>
              {% if p.compare_at_price > p.price %}<span class="text-sm text-muted line-through">{{ p.compare_at_price | money }}</span>{% endif %}
            </div>
            <div class="mt-4 inline-flex items-center gap-2 text-sm font-medium border-b border-ink pb-1">View details <i class="ri-arrow-right-up-line"></i></div>
          </div>
        </a>
        {% if p.description != blank %}
        <div class="mt-4 text-xs leading-relaxed text-muted line-clamp-3 border-l-2 border-stone pl-4">
          {{ p.description | strip_html | truncate: 180 }}
        </div>
        {% endif %}
      {% else %}
        <div class="bg-white border border-stone rounded-[24px] p-10 text-center">
          <div class="w-12 h-12 border border-stone rounded-full grid place-items-center mx-auto"><i class="ri-book-open-line"></i></div>
          <div class="text-sm font-medium mt-4">Your featured product will appear here</div>
          <div class="text-xs text-muted mt-1">Add a product and select it in the hero settings, or it will default to your first product.</div>
        </div>
      {% endif %}
    </div>
  </div>
</section>
{% schema %}{"name":"Hero Editorial","settings":[{"type":"text","id":"heading","label":"Heading","default":"A library"},{"type":"text","id":"subheading","label":"Subheading","default":"for the curious."},{"type":"textarea","id":"description","label":"Description"},{"type":"product","id":"featured_product","label":"Featured product"}]}{% endschema %}
