<section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="grid lg:grid-cols-12 gap-8 items-center bg-white rounded-2xl border border-line p-6 sm:p-10">
    <div class="lg:col-span-6">
      <div class="inline-flex bg-gold text-ink text-xs font-bold px-2.5 py-1 rounded-full">MAVIZIO ORIGINALS</div>
      <h1 class="font-serif text-[36px] sm:text-[48px] leading-[0.95] font-bold mt-3">Read it today,<br><span class="italic font-light text-gold">own it forever.</span></h1>
      <p class="text-sm leading-relaxed text-muted max-w-[480px] mt-3">Curated ebooks — business, fiction, UPSC, tech. Instant PDF + EPUB, lifetime access, GST invoice. No courier wait.</p>
      <a href="{{ routes.collections_url }}/all" class="inline-flex items-center gap-2 bg-ink text-white px-6 py-3 rounded-full font-bold text-sm mt-6 hover:bg-black">Shop Now <i class="ri-arrow-right-line"></i></a>
      <div class="flex items-center gap-3 mt-6 text-xs text-muted"><span class="flex items-center gap-1"><i class="ri-shield-check-line text-leaf"></i> Secure</span><span class="w-1 h-1 bg-line rounded-full"></span><span>Instant download</span><span class="w-1 h-1 bg-line rounded-full"></span><span>1,842 reviews 4.9★</span></div>
    </div>
    <div class="lg:col-span-6 flex justify-center lg:justify-end">
      <div class="w-[280px] sm:w-[340px] aspect-[3/4] rounded-2xl overflow-hidden border border-line shadow-lg bg-paper p-2">
        {% assign p = all_products[section.settings.featured_product] %}
        {% if p == blank %}{% assign p = collections.all.products.first %}{% endif %}
        {% if p and p.featured_image %}
          <img src="{{ p.featured_image | image_url: width: 600 }}" alt="{{ p.title | escape }}" class="w-full h-full object-cover rounded-xl">
        {% else %}
          <div class="w-full h-full rounded-xl bg-ink text-white flex flex-col p-6">
            <div class="text-[10px] tracking-widest text-white/60">MAVIZIO ORIGINALS</div>
            <div class="mt-auto"><div class="font-serif text-2xl font-bold leading-none">CHRONICLES<br>OF ELORIA</div><div class="text-xs text-white/60 mt-2">Elias Thorne</div></div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>
{% schema %}{"name":"Hero Clean","settings":[{"type":"product","id":"featured_product","label":"Featured book"}]}{% endschema %}
