<section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-8">
  <div class="grid lg:grid-cols-12 gap-4 sm:gap-6 items-stretch min-w-0">
    <!-- LEFT - Dark Selling Hero -->
    <div class="relative overflow-hidden rounded-[28px] bg-ink text-white p-6 sm:p-8 lg:p-10 flex flex-col justify-between min-h-[520px] lg:col-span-7">
      <div class="absolute inset-0 opacity-[0.06]" style="background-image:radial-gradient(circle at 1px 1px, white 1px, transparent 0);background-size:22px 22px"></div>
      <div class="absolute -right-24 -bottom-24 w-[420px] h-[420px] bg-gold/15 blur-[90px] rounded-full"></div>
      <div class="absolute -left-20 -top-20 w-[300px] h-[300px] bg-red/10 blur-[80px] rounded-full"></div>
      <div class="relative">
        <div class="inline-flex flex-wrap items-center gap-2 text-[11px] font-extrabold tracking-widest">
          <span class="bg-red text-white px-2.5 py-1 rounded-full flex items-center gap-1"><span class="w-1.5 h-1.5 bg-white rounded-full animate-ping"></span> 12,847+ DOWNLOADED TODAY</span>
          <span class="bg-white/10 backdrop-blur border border-white/15 rounded-full px-3 py-1 flex items-center gap-1.5"><i class="ri-star-fill text-gold"></i> 4.9/5 (2,400+ reviews)</span>
        </div>
        <h1 class="display text-[36px] xs:text-[42px] sm:text-[54px] lg:text-[58px] leading-[0.9] tracking-tight mt-5 font-extrabold">
          {{ section.settings.heading | default: 'Read it today,' }}<br>
          <span class="serif2 italic font-normal text-gold">{{ section.settings.subheading | default: 'own it forever.' }}</span>
        </h1>
        <p class="text-white/70 text-[14px] sm:text-[16px] leading-relaxed max-w-[520px] mt-4 font-medium">
          {{ section.settings.description | default: 'Business, Self-Help, Fiction, UPSC — 50,000+ readers. Pay via UPI / Razorpay & download in 10 seconds. No shipping, no waiting.' }}
        </p>
        <div class="grid grid-cols-3 gap-2 mt-6 max-w-[420px]">
          <div class="bg-white/10 backdrop-blur border border-white/10 rounded-2xl p-3 text-center"><div class="text-gold"><i class="ri-flashlight-fill"></i></div><div class="text-xs font-bold mt-1">10 Sec</div><div class="text-[10px] text-white/60">Delivery</div></div>
          <div class="bg-white/10 backdrop-blur border border-white/10 rounded-2xl p-3 text-center"><div class="text-gold"><i class="ri-refund-2-fill"></i></div><div class="text-xs font-bold mt-1">30-Day</div><div class="text-[10px] text-white/60">Refund</div></div>
          <div class="bg-white/10 backdrop-blur border border-white/10 rounded-2xl p-3 text-center"><div class="text-gold"><i class="ri-infinity-fill"></i></div><div class="text-xs font-bold mt-1">Lifetime</div><div class="text-[10px] text-white/60">Access</div></div>
        </div>
        <div class="flex flex-wrap gap-3 mt-6">
          <a href="{{ routes.collections_url }}/all" class="inline-flex items-center gap-2 bg-gold text-ink px-7 py-3.5 rounded-full font-extrabold text-sm hover:bg-white transition shine">Shop Bestsellers — 40% OFF <i class="ri-arrow-right-line"></i></a>
          <a href="#bestsellers" class="inline-flex items-center gap-2 bg-white/10 backdrop-blur border border-white/20 text-white px-6 py-3.5 rounded-full font-bold text-sm hover:bg-white hover:text-ink transition"><i class="ri-play-circle-line"></i> See what’s inside</a>
        </div>
        <div class="flex flex-wrap items-center gap-3 mt-6 bg-white/5 backdrop-blur border border-white/10 rounded-2xl p-3">
          <div class="flex -space-x-2">
            <img src="https://i.pravatar.cc/100?img=32" class="w-8 h-8 rounded-full border-2 border-ink"><img src="https://i.pravatar.cc/100?img=14" class="w-8 h-8 rounded-full border-2 border-ink"><img src="https://i.pravatar.cc/100?img=28" class="w-8 h-8 rounded-full border-2 border-ink"><span class="w-8 h-8 rounded-full bg-gold text-ink grid place-items-center text-[10px] font-bold border-2 border-ink">+12k</span>
          </div>
          <div class="text-xs leading-tight"><div class="font-bold">Loved by 50k+ readers</div><div class="text-white/60">“Worth every rupee — instant download”</div></div>
          <div class="ml-auto hidden sm:flex items-center gap-2 bg-green-500 text-white px-3 py-1.5 rounded-full text-xs font-bold"><span class="w-2 h-2 bg-white rounded-full animate-pulse"></span><span data-viewers>1,847</span> live</div>
        </div>
      </div>
    </div>

    <!-- RIGHT - Product + Stats -->
    <div class="grid lg:col-span-5 gap-4 sm:gap-6">
      {% assign featured_product = section.settings.featured_product %}
      {% if featured_product != blank %}{% assign p = all_products[featured_product] %}{% else %}{% assign p = collections.all.products.first %}{% endif %}
      {% if p %}
      <div class="relative overflow-hidden rounded-[28px] bg-white border border-black/5 p-5 sm:p-6 flex flex-col sm:flex-row gap-5 items-center sm:items-start">
        <div class="absolute top-0 right-0 bg-red text-white text-[11px] font-extrabold tracking-widest px-4 py-1.5 rounded-bl-2xl flex items-center gap-1"><i class="ri-fire-fill"></i> EDITORS' CHOICE • SELLING FAST</div>
        <div class="shrink-0">
          <div class="w-[160px] sm:w-[185px] h-[230px] sm:h-[268px] rounded-2xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.22)] sm:rotate-[-1.5deg] relative bg-gradient-to-br from-[#1A2332] to-[#0F172A] p-3 flex flex-col">
            {% if p.featured_image %}<img src="{{ p.featured_image | image_url: width: 400 }}" alt="{{ p.title }}" class="absolute inset-0 w-full h-full object-cover opacity-60"><div class="absolute inset-0 bg-gradient-to-br from-[#1A2332]/70 to-[#0F172A]/70"></div>{% endif %}
            <div class="relative text-[9px] tracking-[0.2em] text-white/60 font-bold">MAVIZIO ORIGINALS • BESTSELLER</div>
            <div class="relative mt-3 text-white leading-tight"><div class="text-[18px] font-bold leading-none display">{{ p.title | truncate: 22 }}</div><div class="text-[11px] text-white/70 mt-2">{{ p.vendor | default: 'Mavizio' }} • English</div></div>
            <div class="relative mt-auto flex items-center justify-between"><span class="text-[10px] bg-white text-ink px-2 py-1 rounded-full font-bold">PDF+EPUB+MOBI</span><span class="text-gold flex text-xs"><i class="ri-star-fill"></i>4.9</span></div>
          </div>
        </div>
        <div class="flex-1 min-w-0 w-full text-center sm:text-left">
          <div class="flex items-center justify-center sm:justify-start gap-2 text-xs font-bold flex-wrap"><span class="bg-red text-white px-2 py-1 rounded-full text-[10px]">60% OFF ENDS TONIGHT</span><span class="bg-green-50 text-green-700 border border-green-200 px-2 py-1 rounded-full flex items-center gap-1"><i class="ri-time-line"></i> <span data-countdown>00:00:00</span></span></div>
          <h3 class="display text-[22px] leading-tight mt-3"><a href="{{ p.url }}">{{ p.title }}</a></h3>
          <p class="text-sm text-muted leading-relaxed mt-1.5 line-clamp-2">{{ p.description | strip_html | truncate: 92 }}</p>
          <div class="flex items-baseline justify-center sm:justify-start gap-2 mt-3 flex-wrap"><span class="text-[28px] font-extrabold">{{ p.price | money }}</span>{% if p.compare_at_price > p.price %}<span class="text-sm line-through text-muted">{{ p.compare_at_price | money }}</span>{% endif %}<span class="bg-red text-white text-xs font-bold px-2 py-1 rounded-full">SAVE {{ p.compare_at_price | minus: p.price | money }}</span></div>
          <div class="text-[11px] font-bold text-green-700 mt-1 flex items-center justify-center sm:justify-start gap-1"><i class="ri-checkbox-circle-fill"></i> 1,200+ bought in last 24h • 4.8★</div>
          <div class="flex gap-2 mt-4"><a href="{{ p.url }}" class="flex-1 bg-ink text-white rounded-full py-3 font-bold text-sm text-center">View Details</a><form method="post" action="{{ routes.cart_add_url }}" class="flex-1"><input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}"><button type="submit" class="w-full bg-gold text-ink rounded-full py-3 font-extrabold text-sm hover:bg-yellow-400 transition">Add to Cart</button></form></div>
          <div class="text-[10px] text-muted text-center sm:text-left mt-2">Free audio summary + Lifetime updates</div>
        </div>
      </div>
      {% endif %}
      <div class="grid grid-cols-3 gap-3">
        <div class="bg-gold rounded-[22px] p-4 flex flex-col justify-center relative overflow-hidden"><div class="absolute -right-6 -top-6 w-20 h-20 bg-white/20 rounded-full blur-xl"></div><div class="relative text-[26px] font-extrabold leading-none">50k+</div><div class="relative text-xs font-bold tracking-wide opacity-70 mt-1">EBOOKS SOLD</div><div class="relative mt-2 text-[10px] font-bold bg-ink text-white inline-flex px-2 py-1 rounded-full self-start">Trusted ★4.9</div></div>
        <div class="bg-white border border-black/5 rounded-[22px] p-4 flex flex-col justify-center"><div class="w-8 h-8 bg-cream rounded-full grid place-items-center text-gold"><i class="ri-flashlight-fill"></i></div><div class="text-sm font-extrabold mt-2">10 Sec</div><div class="text-xs text-muted">Email + WA</div><div class="text-[10px] font-bold text-green-600 mt-1">Instant</div></div>
        <div class="bg-ink text-white rounded-[22px] p-4 flex flex-col justify-center relative overflow-hidden"><div class="absolute inset-0 bg-gradient-to-br from-gold/20 to-transparent"></div><div class="relative w-8 h-8 bg-white/10 rounded-full grid place-items-center"><i class="ri-customer-service-2-fill text-gold"></i></div><div class="relative text-sm font-bold mt-2">Lifetime</div><div class="relative text-xs text-white/60">Re-download</div><div class="relative text-[10px] font-bold text-gold mt-1">Free updates</div></div>
      </div>
    </div>
  </div>
</section>
{% schema %}{"name":"Hero Selling","settings":[{"type":"text","id":"heading","label":"Heading","default":"Read it today,"},{"type":"text","id":"subheading","label":"Subheading","default":"own it forever."},{"type":"textarea","id":"description","label":"Description"},{"type":"product","id":"featured_product","label":"Featured product"}]}{% endschema %}
