<div class="bg-white border-b border-line">
  <div class="max-w-[960px] mx-auto px-4 sm:px-6 lg:px-8 py-2.5">
    <nav class="flex items-center gap-1.5 text-xs text-muted"><a href="{{ routes.root_url }}" class="hover:text-ink">Home</a><i class="ri-arrow-right-s-line text-line"></i><span class="text-ink font-medium">About Us</span></nav>
  </div>
</div>
<div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 mt-4 grid lg:grid-cols-12 gap-4">
  <div class="lg:col-span-5 bg-white rounded-2xl border border-line p-6 sm:p-8">
    <div class="text-[11px] tracking-[0.2em] text-muted font-semibold">— OUR STORY • EST. 2024</div>
    <h1 class="font-serif text-[36px] sm:text-[42px] leading-[0.95] font-bold mt-3">Built for readers <span class="text-gold italic font-light">who do.</span></h1>
    <p class="text-sm leading-relaxed text-muted mt-4">Mavizio is India's clean digital bookstore — no warehouses, no shipping. Curated ebooks for Business, Self-Help, Fiction, UPSC, Tech & Finance. Pay via Razorpay/UPI, get PDF+EPUB in 10 seconds, lifetime re-download.</p>
    <div class="grid grid-cols-3 gap-3 mt-6">
      <div class="bg-paper border border-line rounded-2xl p-3 text-center"><div class="text-lg font-bold">50k+</div><div class="text-[11px] tracking-wide text-muted">READERS</div></div>
      <div class="bg-ink text-white rounded-2xl p-3 text-center"><div class="text-lg font-bold text-gold">4.9★</div><div class="text-[11px] tracking-wide text-white/60">2,400 REVIEWS</div></div>
      <div class="bg-paper border border-line rounded-2xl p-3 text-center"><div class="text-lg font-bold">10s</div><div class="text-[11px] tracking-wide text-muted">DELIVERY</div></div>
    </div>
  </div>
  <div class="lg:col-span-7 bg-white rounded-2xl border border-line overflow-hidden">
    <img src="https://images.unsplash.com/photo-1512820790803-83ca734da794?w=900&h=600&fit=crop" alt="Mavizio Store" class="w-full h-[280px] object-cover">
    <div class="p-6">
      <h3 class="font-bold">Why digital?</h3>
      <p class="text-sm text-muted leading-relaxed mt-2">Pay, get email + WhatsApp with PDF/EPUB/MOBI + audio summary. Re-download anytime. GST invoice included. 30-day refund.</p>
      <div class="mt-4 flex flex-wrap gap-2 text-xs"><span class="bg-gold text-ink px-3 py-1 rounded-full font-bold">Razorpay Secure</span><span class="bg-paper border border-line px-3 py-1 rounded-full">UPI • Cards • Netbanking</span></div>
    </div>
  </div>
</div>
<div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 mt-4">
  <div class="bg-white rounded-2xl border border-line p-6 sm:p-8">
    <div class="text-xs tracking-widest text-muted font-semibold">WHAT YOU GET</div>
    <div class="grid sm:grid-cols-2 gap-3 mt-4 text-sm">
      <span class="flex gap-2 items-center"><i class="ri-checkbox-circle-fill text-leaf"></i> PDF + EPUB + MOBI + Audio summary</span>
      <span class="flex gap-2 items-center"><i class="ri-checkbox-circle-fill text-leaf"></i> Lifetime free updates</span>
      <span class="flex gap-2 items-center"><i class="ri-checkbox-circle-fill text-leaf"></i> Works on phone, Kindle, laptop</span>
      <span class="flex gap-2 items-center"><i class="ri-checkbox-circle-fill text-leaf"></i> 30-day money-back guarantee</span>
    </div>
    {% if page.content != blank %}<div class="mt-6 prose max-w-none prose-sm">{{ page.content }}</div>{% endif %}
  </div>
</div>
{% schema %}{"name":"Main About Clean","settings":[]}{% endschema %}
