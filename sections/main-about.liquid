<div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="grid lg:grid-cols-12 gap-8 items-start">
    <div class="lg:col-span-5">
      <div class="text-[11px] tracking-[0.2em] text-white/40">— OUR STORY • EST. 2024</div>
