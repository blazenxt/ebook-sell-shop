<section class="max-w-[860px] mx-auto px-4 sm:px-6 lg:px-8 mt-8">
  <div class="text-center">
    <div class="inline-flex items-center gap-2 bg-white border border-black/5 rounded-full px-3 py-1 text-xs font-bold"><i class="ri-question-line"></i> FAQ • Got questions?</div>
    <h2 class="display text-[26px] sm:text-[32px] leading-none mt-2 font-extrabold">Everything you need to know</h2>
  </div>
  <div class="mt-6 bg-white border border-black/5 rounded-[24px] divide-y divide-black/5 overflow-hidden">
    {% assign faqs = "How will I get my ebook after payment?:Instantly. After Razorpay/UPI success, download links arrive on email + WhatsApp within 10 seconds. Also available in your account for lifetime re-download.;What format will I get?:Every ebook includes PDF + EPUB + MOBI + free audio summary. Works on phone, Kindle, laptop.;What if I don't like it?:30-day money-back guarantee. Email us, full refund no questions — we take the risk.;Can I read on phone/Kindle?:Yes. PDF for phone/laptop, EPUB for Apple Books, MOBI for Kindle. One purchase, all devices." | split: ";" %}
    {% for f in faqs %}
      {% assign parts = f | split: ":" %}
      <button data-faq-trigger class="w-full text-left px-5 sm:px-6 py-4 flex items-center justify-between gap-4 hover:bg-paper/50 transition">
        <span class="font-bold text-sm sm:text-[15px]">{{ parts[0] }}</span>
        <span data-faq-icon class="w-7 h-7 rounded-full bg-ink text-white grid place-items-center text-sm shrink-0">+</span>
      </button>
      <div class="hidden px-5 sm:px-6 pb-4 text-sm text-muted leading-relaxed">{{ parts[1] }}</div>
    {% endfor %}
  </div>
  <div class="mt-6 bg-ink rounded-[20px] p-5 flex flex-col sm:flex-row items-center justify-between gap-4 text-white text-center sm:text-left">
    <div><div class="font-extrabold">Still unsure?</div><div class="text-sm text-white/70">Chat on WhatsApp — replies in 2 mins • 9am-11pm IST</div></div>
    <a href="https://wa.me/919000012345" class="bg-green-500 text-white px-6 py-3 rounded-full font-bold text-sm flex items-center gap-2"><i class="ri-whatsapp-fill"></i> Chat on WhatsApp</a>
  </div>
</section>
{% schema %}{"name":"FAQ Selling","settings":[]}{% endschema %}
