<div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-4">
  <nav class="flex items-center gap-2 text-xs font-semibold text-muted">
    <a href="{{ routes.root_url }}" class="hover:text-ink">Home</a> <i class="ri-arrow-right-s-line"></i> <span class="text-ink">{{ collection.title }}</span>
  </nav>
</div>

<section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 pb-12">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <h1 class="display text-[30px] sm:text-[40px] leading-none tracking-tight">{{ collection.title }}</h1>
      {% if collection.description != blank %}<p class="text-sm text-muted mt-2 max-w-[560px] leading-relaxed">{{ collection.description }}</p>{% endif %}
    </div>
    <span class="self-start sm:self-auto bg-white border border-black/10 rounded-full px-4 py-2 text-xs font-bold shrink-0">{{ collection.products_count }} ebooks</span>
  </div>

  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mt-8">
    {% for product in collection.products %}
      <a href="{{ product.url }}" class="group bg-white border border-black/[0.06] rounded-[22px] overflow-hidden flex flex-col hover:shadow-[0_12px_32px_rgba(0,0,0,0.08)] hover:-translate-y-1 transition-all duration-300">
        <div class="relative overflow-hidden bg-sand aspect-[4/3]">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="w-full h-full object-cover group-hover:scale-[1.03] transition duration-700">
          {% else %}
            <div class="w-full h-full grid place-items-center text-muted"><i class="ri-image-line text-2xl"></i></div>
          {% endif %}
          {% if product.compare_at_price > product.price %}
            <span class="absolute top-3 left-3 bg-red text-white text-[11px] font-extrabold px-2.5 py-1 rounded-full">60% OFF</span>
          {% endif %}
          <span class="absolute bottom-3 left-3 bg-white/95 backdrop-blur text-[11px] font-bold px-2.5 py-1 rounded-full border border-black/5">PDF + EPUB</span>
        </div>
        <div class="p-4 flex-1 flex flex-col">
          <div class="text-[11px] tracking-[0.12em] text-muted font-bold">{{ product.vendor | default: 'Mavizio' | upcase }}</div>
          <h3 class="font-bold leading-tight mt-1 line-clamp-2 min-h-[2.6em] text-[14px] sm:text-[15px] break-words">{{ product.title }}</h3>
          <div class="flex items-baseline gap-2 mt-3">
            <span class="text-[18px] font-extrabold tracking-tight">{{ product.price | money }}</span>
            {% if product.compare_at_price > product.price %}<span class="text-xs line-through text-muted">{{ product.compare_at_price | money }}</span>{% endif %}
          </div>
          <div class="mt-3 bg-ink text-white rounded-full py-2 text-xs font-bold text-center group-hover:bg-black transition">View Details</div>
        </div>
      </a>
    {% else %}
      <div class="col-span-full text-center py-16 bg-white rounded-[20px] border border-black/5">
        <div class="w-14 h-14 bg-paper border border-black/5 rounded-full grid place-items-center mx-auto"><i class="ri-search-line text-xl"></i></div>
        <div class="font-bold mt-3">No products found</div>
        <div class="text-sm text-muted">Add products to this collection in Shopify admin</div>
      </div>
    {% endfor %}
  </div>
</section>
{% schema %}{"name":"Main Collection","settings":[]}{% endschema %}
