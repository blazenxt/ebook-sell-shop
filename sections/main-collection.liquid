<div class="bg-white border-b border-line">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-3">
    <nav class="flex items-center gap-1.5 text-xs text-muted"><a href="{{ routes.root_url }}" class="hover:text-ink">Home</a><i class="ri-arrow-right-s-line text-line"></i><span class="text-ink font-medium">{{ collection.title }}</span></nav>
  </div>
</div>
<section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 mt-4">
  <div class="bg-white rounded-2xl border border-line p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div><h1 class="font-serif text-xl sm:text-2xl font-bold">{{ collection.title }}</h1>{% if collection.description != blank %}<p class="text-sm text-muted mt-1 max-w-[640px]">{{ collection.description }}</p>{% endif %}<div class="mt-2 inline-flex items-center gap-2 text-xs"><span class="bg-leafSoft text-leaf border border-leaf/10 px-2.5 py-1 rounded-full font-bold">Instant delivery</span><span class="bg-cream border border-gold/20 px-2.5 py-1 rounded-full font-bold text-ink">GST invoice</span></div></div>
    <span class="self-start sm:self-auto text-xs bg-paper border border-line rounded-full px-4 py-2 font-bold">{{ collection.products_count }} items • 10-sec delivery</span>
  </div>
  <div class="bg-white rounded-2xl border border-line mt-4 p-3 sm:p-4">
    {% if collection.products_count > 0 %}
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
      {% for product in collection.products %}
        <a href="{{ product.url }}" class="group bg-white border border-line rounded-2xl p-3 hover:border-ink hover:bg-paper/50 transition flex flex-col mv-card">
          <div class="aspect-[3/4] flex items-center justify-center p-2 bg-paper rounded-xl border border-line group-hover:bg-white transition">
            {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 320 }}" alt="{{ product.title | escape }}" class="max-h-full max-w-full object-contain group-hover:scale-105 transition duration-500">{% else %}<div class="w-full h-full grid place-items-center text-muted"><i class="ri-book-line text-2xl"></i></div>{% endif %}
          </div>
          <div class="mt-3 flex-1 flex flex-col">
            <div class="text-[11px] tracking-wide text-muted truncate">{{ product.vendor | default: 'Mavizio' }}</div>
            <div class="text-sm leading-tight line-clamp-2 min-h-[2.5em] mt-1 font-medium">{{ product.title }}</div>
            <div class="flex items-center gap-1.5 mt-2"><span class="bg-leaf text-white text-[11px] px-1.5 py-0.5 rounded-full flex items-center gap-0.5 font-bold">4.9 <i class="ri-star-fill text-[9px]"></i></span><span class="text-xs text-muted">(1.2k)</span><span class="ml-auto hidden sm:inline text-[10px] bg-leafSoft text-leaf border border-leaf/10 px-1.5 py-0.5 rounded-full font-bold">Assured</span></div>
            <div class="flex items-baseline gap-2 mt-2"><span class="font-bold text-sm">{{ product.price | money }}</span>{% if product.compare_at_price > product.price %}<span class="text-xs line-through text-muted">{{ product.compare_at_price | money }}</span>{% endif %}</div>
            {% if product.compare_at_price > product.price %}<div class="text-xs text-leaf font-bold bg-leafSoft border border-leaf/10 inline-flex px-1.5 py-0.5 rounded-full mt-1">{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}% off • Bank Offer</div>{% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
    {% else %}
      <div class="text-center py-12"><div class="w-12 h-12 bg-paper border border-line rounded-full grid place-items-center mx-auto"><i class="ri-inbox-line text-xl text-muted"></i></div><div class="text-sm font-semibold mt-3">No products in this collection</div><div class="text-xs text-muted mt-1">Add products in Shopify Admin → Products</div></div>
    {% endif %}
  </div>
</section>
{% schema %}{"name":"Main Collection Refined","settings":[]}{% endschema %}
