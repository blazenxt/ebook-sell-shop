<div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-4 border-b border-white/10">
  <nav class="flex items-center gap-2 text-xs text-white/50"><a href="{{ routes.root_url }}" class="hover:text-white">Home</a> <i class="ri-arrow-right-s-line"></i> <span class="text-white">{{ collection.title }}</span></nav>
</div>
<section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="display text-[30px] sm:text-[36px] text-white">{{ collection.title }}</h1>
  <p class="text-sm text-white/50 mt-2">{{ collection.products_count }} titles</p>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mt-8">
    {% for product in collection.products %}
      <a href="{{ product.url }}" class="bg-[#141414] border border-white/10 rounded-[12px] overflow-hidden flex flex-col hover:border-[#FFB800]/30 transition">
        <div class="aspect-[3/4] overflow-hidden bg-[#1A1A1A]">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" class="w-full h-full object-cover">{% endif %}</div>
        <div class="p-4 flex-1 flex flex-col">
          <div class="text-sm font-medium text-white line-clamp-2">{{ product.title }}</div>
          <div class="text-xs text-white/50 mt-1">{{ product.vendor }}</div>
          <div class="text-sm font-bold text-[#FFB800] mt-2">{{ product.price | money }}</div>
        </div>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}{"name":"Main Collection Luxury","settings":[]}{% endschema %}
