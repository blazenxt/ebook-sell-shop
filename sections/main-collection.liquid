<div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-6 border-b border-stone/50">
  <nav class="flex items-center gap-2 text-xs text-muted">
    <a href="{{ routes.root_url }}" class="hover:text-ink">Home</a><i class="ri-arrow-right-s-line"></i><span class="text-ink">{{ collection.title }}</span>
  </nav>
</div>

<section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-stone pb-6">
    <div>
      <h1 class="display text-[32px] sm:text-[40px] leading-none">{{ collection.title }}</h1>
      {% if collection.description != blank %}<p class="text-sm text-muted mt-2 max-w-[560px]">{{ collection.description }}</p>{% else %}<p class="text-sm text-muted mt-2">{{ collection.products_count }} titles</p>{% endif %}
    </div>
    <div class="text-xs text-muted border border-stone rounded-full px-3 py-1.5">{{ collection.products_count }} titles</div>
  </div>

  {% if collection.products_count > 0 %}
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mt-8">
    {% for product in collection.products %}
      <a href="{{ product.url }}" class="group">
        <div class="aspect-[3/4] overflow-hidden rounded-[20px] border border-stone bg-sand">
          {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="w-full h-full object-cover group-hover:scale-[1.02] transition duration-700">{% else %}<div class="w-full h-full grid place-items-center text-muted"><i class="ri-image-line text-2xl"></i></div>{% endif %}
        </div>
        <div class="pt-3">
          <div class="text-[11px] tracking-[0.18em] text-muted">{{ product.type | default: 'Ebook' | upcase }}</div>
          <div class="text-sm font-medium leading-tight mt-1 line-clamp-2">{{ product.title }}</div>
          <div class="text-sm font-semibold mt-2">{{ product.price | money }}{% if product.compare_at_price > product.price %} <span class="text-xs text-muted line-through font-normal">{{ product.compare_at_price | money }}</span>{% endif %}</div>
        </div>
      </a>
    {% endfor %}
  </div>
  {% else %}
    <div class="mt-12 bg-white border border-stone rounded-[20px] p-10 text-center">
      <div class="text-sm font-medium">No titles in this collection</div>
      <div class="text-sm text-muted mt-1">Add products to “{{ collection.title }}” in Shopify Admin.</div>
    </div>
  {% endif %}
</section>
{% schema %}{"name":"Main Collection Clean","settings":[]}{% endschema %}
