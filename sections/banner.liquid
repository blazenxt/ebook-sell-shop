<div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 mt-4">
  <div class="bg-white rounded-2xl border border-line overflow-hidden grid md:grid-cols-12">
    <div class="md:col-span-8 relative min-h-[220px] sm:min-h-[320px]">
      <img src="https://images.unsplash.com/photo-1512820790803-83ca734da794?w=1200&h=600&fit=crop" alt="Mavizio" class="absolute inset-0 w-full h-full object-cover">
