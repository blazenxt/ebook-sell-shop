<div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-8 border-b border-white/10">
  <h1 class="display text-[30px] sm:text-[36px] text-white">Search</h1>
  <form action="{{ routes.search_url }}" method="get" class="mt-4 flex gap-2 max-w-[560px]">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search titles, topics" class="flex-1 bg-[#141414] border border-white/10 rounded-full px-5 py-3 text-sm text-white placeholder:text-white/40 focus:outline-none focus:border-[#FFB800]/50">
    <button type="submit" class="bg-[#FFB800] text-black px-6 py-3 rounded-full text-sm font-bold">Search</button>
  </form>
</div>
{% if search.performed %}
<section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="text-sm text-white/50">{{ search.results_count }} results for “{{ search.terms | escape }}”</div>
  {% if search.results_count > 0 %}
  <div class="grid gap-4 mt-6 max-w-[820px]">
    {% for item in search.results %}
      {% if item.object_type == 'product' %}
        <a href="{{ item.url }}" class="flex gap-4 bg-[#141414] border border-white/10 rounded-[16px] p-4 hover:border-[#FFB800]/30 transition">
          {% if item.featured_image %}<img src="{{ item.featured_image | image_url: width: 200 }}" alt="{{ item.title | escape }}" class="w-20 h-28 object-cover rounded-md bg-[#1A1A1A] shrink-0">{% endif %}
          <div class="flex-1 min-w-0">
            <div class="text-[11px] tracking-[0.15em] text-white/40">{{ item.type | default: 'Ebook' | upcase }}</div>
            <div class="text-sm font-medium text-white mt-1 line-clamp-2">{{ item.title }}</div>
            <div class="text-sm font-bold text-[#FFB800] mt-2">{{ item.price | money }}</div>
          </div>
        </a>
      {% else %}
        <a href="{{ item.url }}" class="block bg-[#141414] border border-white/10 rounded-[16px] p-5 hover:border-white/20 transition">
          <div class="text-[11px] tracking-[0.15em] text-white/40">{{ item.object_type | upcase }}</div>
          <div class="text-sm font-medium text-white mt-1">{{ item.title }}</div>
          <div class="text-sm text-white/60 mt-2 line-clamp-2">{{ item.content | strip_html | truncate: 160 }}</div>
        </a>
      {% endif %}
    {% endfor %}
  </div>
  {% else %}
    <div class="bg-[#141414] border border-white/10 rounded-[16px] p-10 text-center mt-6">
      <div class="text-sm font-medium text-white">No results</div>
      <div class="text-sm text-white/50 mt-1">Try a different keyword</div>
      <a href="{{ routes.collections_url }}/all" class="inline-flex mt-4 bg-[#FFB800] text-black px-5 py-2.5 rounded-full text-sm font-bold">Browse all</a>
    </div>
  {% endif %}
</section>
{% endif %}
{% schema %}{"name":"Main Search Luxury","settings":[]}{% endschema %}
