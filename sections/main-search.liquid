<div class="bg-white border-b border-line">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-3">
    <div class="flex items-center gap-2 text-xs text-muted"><a href="{{ routes.root_url }}" class="hover:text-ink">Home</a> <i class="ri-arrow-right-s-line text-line"></i> <span class="text-ink font-medium">Search</span></div>
  </div>
</div>
<div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 mt-4">
  <div class="bg-white rounded-2xl border border-line p-5">
    <h1 class="font-serif text-xl font-bold">Search</h1>
    <form action="{{ routes.search_url }}" method="get" class="mt-3 flex gap-2 max-w-[560px]">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search ebooks, authors..." class="flex-1 border border-line rounded-full px-4 py-2.5 text-sm focus:outline-none focus:border-ink bg-paper">
      <button type="submit" class="bg-ink text-white px-6 py-2.5 rounded-full text-sm font-bold">Search</button>
    </form>
  </div>
  {% if search.performed %}
  <div class="bg-white rounded-2xl border border-line mt-4 p-5">
    <div class="text-sm text-muted">{{ search.results_count }} results for “{{ search.terms | escape }}”</div>
    {% if search.results_count > 0 %}
    <div class="grid gap-3 mt-4 max-w-[820px]">
      {% for item in search.results %}
        {% if item.object_type == 'product' %}
          <a href="{{ item.url }}" class="flex gap-4 border border-line rounded-xl p-3 hover:border-ink transition bg-white">
            {% if item.featured_image %}<img src="{{ item.featured_image | image_url: width: 200 }}" alt="{{ item.title | escape }}" class="w-16 h-20 object-contain border border-line rounded-lg p-1 bg-paper shrink-0">{% endif %}
            <div class="flex-1 min-w-0"><div class="text-sm font-medium line-clamp-2">{{ item.title }}</div><div class="text-sm font-bold mt-1">{{ item.price | money }}</div></div>
          </a>
        {% else %}
          <a href="{{ item.url }}" class="block border border-line rounded-xl p-3 hover:border-ink bg-white"><div class="text-xs text-muted">{{ item.object_type | upcase }}</div><div class="text-sm font-medium mt-1">{{ item.title }}</div></a>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </div>
  {% endif %}
</div>
{% schema %}{"name":"Main Search Clean","settings":[]}{% endschema %}
