<div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-8 border-b border-stone/50">
  <h1 class="display text-[32px] sm:text-[40px] leading-none">Search</h1>
  <form action="{{ routes.search_url }}" method="get" class="mt-6 flex gap-2 max-w-[560px]">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search titles, topics" class="flex-1 bg-white border border-stone rounded-full px-5 py-3 text-sm focus:outline-none focus:border-ink/20">
    <button type="submit" class="bg-ink text-paper px-6 py-3 rounded-full text-sm font-medium">Search</button>
  </form>
</div>
{% if search.performed %}
<section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="text-sm text-muted">{{ search.results_count }} results for “{{ search.terms | escape }}”</div>
  {% if search.results_count > 0 %}
  <div class="grid gap-4 mt-6 max-w-[820px]">
    {% for item in search.results %}
      {% if item.object_type == 'product' %}
        <a href="{{ item.url }}" class="flex gap-4 bg-white border border-stone rounded-[20px] p-4 hover:border-ink/20 transition">
          {% if item.featured_image %}<img src="{{ item.featured_image | image_url: width: 200 }}" alt="{{ item.title | escape }}" class="w-20 h-28 object-cover rounded-xl border border-stone bg-sand shrink-0">{% endif %}
          <div class="flex-1 min-w-0">
            <div class="text-[11px] tracking-[0.18em] text-muted">{{ item.type | default: 'Ebook' | upcase }}</div>
            <div class="text-sm font-medium mt-1 line-clamp-2">{{ item.title }}</div>
            <div class="text-sm font-semibold mt-2">{{ item.price | money }}</div>
          </div>
        </a>
      {% else %}
        <a href="{{ item.url }}" class="block bg-white border border-stone rounded-[20px] p-5 hover:border-ink/20 transition">
          <div class="text-[11px] tracking-[0.18em] text-muted">{{ item.object_type | upcase }}</div>
          <div class="text-sm font-medium mt-1">{{ item.title }}</div>
          <div class="text-sm text-muted mt-2 line-clamp-2">{{ item.content | strip_html | truncate: 160 }}</div>
        </a>
      {% endif %}
    {% endfor %}
  </div>
  {% else %}
    <div class="bg-white border border-stone rounded-[20px] p-10 text-center mt-6">
      <div class="text-sm font-medium">No results</div>
      <div class="text-sm text-muted mt-1">Try a different keyword or browse collections.</div>
      <a href="{{ routes.collections_url }}/all" class="inline-flex mt-4 bg-ink text-paper px-5 py-2.5 rounded-full text-sm">Browse all</a>
    </div>
  {% endif %}
</section>
{% endif %}
{% schema %}{"name":"Main Search Clean","settings":[]}{% endschema %}
