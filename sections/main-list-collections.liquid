<div class="bg-white border-b border-line">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <h1 class="font-serif text-xl font-bold">All Collections</h1>
    <p class="text-xs text-muted">{{ collections.size }} collections</p>
  </div>
</div>
<section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 mt-4">
  <div class="bg-white rounded-2xl border border-line p-4">
    {% if collections.size > 0 %}
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
      {% for collection in collections %}
        <a href="{{ collection.url }}" class="group border border-line rounded-2xl p-3 hover:border-ink transition flex flex-col bg-white mv-card">
          <div class="aspect-[4/3] bg-paper rounded-xl overflow-hidden border border-line">{% if collection.featured_image %}<img src="{{ collection.featured_image | image_url: width: 400 }}" alt="{{ collection.title | escape }}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">{% else %}<div class="w-full h-full grid place-items-center text-muted"><i class="ri-folder-3-line text-xl"></i></div>{% endif %}</div>
          <div class="pt-3"><div class="text-sm font-semibold">{{ collection.title }}</div><div class="text-xs text-muted">{{ collection.products_count }} items</div></div>
        </a>
      {% endfor %}
    </div>
    {% else %}
      <div class="text-center py-12 text-sm text-muted">No collections yet</div>
    {% endif %}
  </div>
</section>
{% schema %}{"name":"Main List Collections Clean","settings":[]}{% endschema %}
