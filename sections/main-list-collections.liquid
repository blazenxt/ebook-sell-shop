<div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-8 border-b border-stone/50">
  <h1 class="display text-[32px] sm:text-[40px] leading-none">Collections</h1>
  <p class="text-sm text-muted mt-2">{{ collections.size }} collections</p>
</div>
<section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-8">
  {% if collections.size > 0 %}
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
    {% for collection in collections %}
      <a href="{{ collection.url }}" class="group">
        <div class="aspect-[4/3] overflow-hidden rounded-[16px] border border-stone bg-sand">
          {% if collection.featured_image %}<img src="{{ collection.featured_image | image_url: width: 500 }}" alt="{{ collection.title | escape }}" class="w-full h-full object-cover group-hover:scale-[1.02] transition duration-700">{% else %}<div class="w-full h-full grid place-items-center text-muted"><i class="ri-folder-3-line text-xl"></i></div>{% endif %}
        </div>
        <div class="pt-3">
          <div class="text-sm font-medium">{{ collection.title }}</div>
          <div class="text-xs text-muted">{{ collection.products_count }} titles</div>
        </div>
      </a>
    {% endfor %}
  </div>
  {% else %}
    <div class="bg-white border border-stone rounded-[20px] p-10 text-center">
      <div class="text-sm font-medium">No collections yet</div>
      <div class="text-sm text-muted mt-1">Create collections in Shopify Admin.</div>
    </div>
  {% endif %}
</section>
{% schema %}{"name":"Main List Collections Clean","settings":[]}{% endschema %}
