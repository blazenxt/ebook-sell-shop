<section id="collection" class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 mt-12 sm:mt-16">
  <div class="flex items-end justify-between gap-6 border-b border-stone pb-4">
    <div>
      <div class="text-[11px] tracking-[0.2em] text-muted">— BROWSE</div>
      <h2 class="display text-[26px] sm:text-[32px] leading-none mt-1">{{ section.settings.heading | default: 'Collections' }}</h2>
    </div>
    <a href="{{ routes.collections_url }}" class="hidden sm:inline-flex text-sm border-b border-ink pb-1">All collections</a>
  </div>

  {% if collections.size > 0 %}
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mt-6">
    {% for collection in collections limit: 6 %}
      <a href="{{ collection.url }}" class="group">
        <div class="aspect-[4/3] overflow-hidden rounded-[16px] border border-stone bg-white">
          {% if collection.featured_image %}
            <img src="{{ collection.featured_image | image_url: width: 400 }}" alt="{{ collection.title }}" class="w-full h-full object-cover group-hover:scale-[1.02] transition duration-700">
          {% else %}
            <div class="w-full h-full grid place-items-center bg-sand text-muted"><i class="ri-folder-3-line text-xl"></i></div>
          {% endif %}
        </div>
        <div class="pt-3">
          <div class="text-sm font-medium leading-tight">{{ collection.title }}</div>
          <div class="text-xs text-muted mt-1">{{ collection.products_count }} {% if collection.products_count == 1 %}title{% else %}titles{% endif %}</div>
        </div>
      </a>
    {% endfor %}
  </div>
  {% else %}
    <div class="mt-6 bg-white border border-stone rounded-[20px] p-8 text-center">
      <div class="text-sm font-medium">No collections yet</div>
      <div class="text-sm text-muted mt-1">Create collections in Shopify Admin → Products → Collections.</div>
    </div>
  {% endif %}
</section>
{% schema %}{"name":"Collection List Clean","settings":[{"type":"text","id":"heading","label":"Heading","default":"Collections"}]}{% endschema %}
