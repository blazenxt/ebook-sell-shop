<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#0A0A0A">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">{%- endif -%}
  <title>{{ page_title }}{% if current_tags %} — {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} — Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=Inter:wght@400;500;600&family=Fraunces:opsz,wght@9..144,600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.2.0/remixicon.min.css">
  <script>
    tailwind.config={theme:{extend:{fontFamily:{display:['Fraunces','serif'],serif:['Cormorant Garamond','serif'],sans:['Inter','sans-serif']},colors:{ink:'#0A0A0A',paper:'#FAF8F5',stone:'#E8E0D0',muted:'#6B6B6B',clay:'#8B7355',sand:'#F5EFE6'}}}}
  </script>
  <style>
    *{font-family:'Inter',sans-serif}
    .display{font-family:'Fraunces',serif;letter-spacing:-0.02em}
    .serif{font-family:'Cormorant Garamond',serif}
    .line-clamp-2{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    html,body{max-width:100%;overflow-x:hidden;background:#FAF8F5;color:#0A0A0A}
    ::selection{background:#0A0A0A;color:#FAF8F5}
  </style>
  {{ 'mavizio.css' | asset_url | stylesheet_tag }}
</head>
<body class="bg-paper text-ink antialiased overflow-x-hidden">
  {% section 'header' %}
  <main id="MainContent" class="focus-none" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>
  {% section 'footer' %}
  <script src="{{ 'mavizio.js' | asset_url }}" defer></script>
</body>
</html>
