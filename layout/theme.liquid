<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#0F0F0F">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}
  <title>{{ page_title }}{% if current_tags %} – tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} – Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,ital,wght@9..144,0,800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.2.0/remixicon.min.css">
  <script>
    tailwind.config={theme:{extend:{fontFamily:{fraunces:['Fraunces','serif'],jakarta:['Plus Jakarta Sans','sans-serif'],serif2:['Instrument Serif','serif']},colors:{ink:'#0F0F0F',paper:'#FDF8F0',cream:'#FFF6E8',gold:'#FFB800',red:'#FF3B30',muted:'#6B6B6B'}}}}
  </script>
  <style>
    *{font-family:'Plus Jakarta Sans',sans-serif}
    .display{font-family:'Fraunces',serif}
    .serif2{font-family:'Instrument Serif',serif}
    .line-clamp-2{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .card-hover{transition:all .35s cubic-bezier(.16,1,.3,1)}
    .card-hover:hover{transform:translateY(-6px);box-shadow:0 20px 40px -12px rgba(0,0,0,.18)}
    html,body{max-width:100%;overflow-x:hidden}
    .ri-star-fill{font-size:13px}
    @keyframes marquee{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
    .marquee{animation:marquee 18s linear infinite}
    @keyframes pulse-gold{0%,100%{box-shadow:0 0 0 0 rgba(255,184,0,0.4)}50%{box-shadow:0 0 0 12px rgba(255,184,0,0)}}
    .pulse-gold{animation:pulse-gold 2s infinite}
    .countdown span{background:#FF3B30;color:white;padding:2px 6px;border-radius:6px;font-weight:800;min-width:28px;display:inline-block;text-align:center}
    /* Prevent text/UI overlap */
    *{overflow-wrap:break-word;word-break:break-word}
    img{max-width:100%;height:auto}
    .line-clamp-2{overflow:hidden}
  </style>
  {{ 'mavizio.css' | asset_url | stylesheet_tag }}
</head>
<body class="bg-paper text-ink antialiased overflow-x-hidden">
  {% section 'header' %}
  <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>
  {% section 'footer' %}
  <!-- Sticky ATC for product pages -->
  <div id="sticky-atc" class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-black/10 shadow-[0_-8px_30px_rgba(0,0,0,0.08)] translate-y-full transition-transform duration-300">
    <div class="max-w-[1280px] mx-auto px-4 py-3 flex items-center gap-3">
      <img id="sticky-img" src="" class="w-12 h-16 object-cover rounded-lg border border-black/5 hidden sm:block">
      <div class="flex-1 min-w-0">
        <div id="sticky-title" class="text-sm font-bold leading-tight line-clamp-1"></div>
        <div class="flex items-center gap-2"><span id="sticky-price" class="font-extrabold text-sm"></span><span class="text-xs text-muted line-through" id="sticky-compare"></span><span class="bg-green-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full">60% OFF</span></div>
      </div>
      <form method="post" action="{{ routes.cart_add_url }}" class="flex gap-2 shrink-0">
        <input type="hidden" name="id" id="sticky-variant">
        <button type="submit" class="bg-gold text-ink px-6 py-3 rounded-full font-extrabold text-sm hover:bg-yellow-400 transition whitespace-nowrap">Add to Cart — <span id="sticky-btn-price"></span></button>
      </form>
    </div>
  </div>
  <script src="{{ 'mavizio.js' | asset_url }}" defer></script>
</body>
</html>
